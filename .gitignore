MANIFEST

# obsidian
.obsidian/

# Virtual environments
.env
.venv
.doc-venv
env/
venv/
venv-agg/

# Jupyter
.ipynb_checkpoints

# Coverage
.coverage
.coverage.*
# NB .pytest_cache needs no entry here: pytest writes its own
# .pytest_cache/.gitignore containing `*`.
htmlcov/
.cache

# Sphinx documentation
docs/_build/
docs/savefig/

# Symlink to the standalone monograph project (C:/s/AI/aggregate-monograph),
# which holds the Quarto ports of the technical and user guides. Convenience
# only; the monograph is its own repository.
docs/AGGREGATE-MONOGRAPH

# LaTeX build artifacts (cheat-sheets/)
cheat-sheets/*.aux
cheat-sheets/*.log
cheat-sheets/preamble.fmt

# Editors / IDEs
.idea/
*.sublime-*
# write back the syntax file
!*.sublime-syntax

# pyenv
.python-version

# Local scratch (ad-hoc throwaway files)
scratch_*
hacks

# docs related
docs/**/*.aux
docs/**/*.log
docs/**/*.pdf
docs/**/*.tex
docs/cookbook/*.quarto_ipynb

# Renders of the Quarto notes under dev/; the .qmd sources are tracked. The
# house kit in dev/_extensions is a copy of the house-style repository.
# Quarto's own cache is ignored by dev/.gitignore, which Quarto writes.
dev/**/*.html
dev/**/*.pdf
dev/**/*_files/
dev/_extensions/

# Symlink to the canonical copy in aggregate_api. Ignored because git stores a
# symlink as a blob holding the literal path, which is meaningless anywhere
# else, the same trap the aggregate_api .venv junction fell into. The canonical
# copy moved to that repo's dev/done/ on 2026-08-21, so the link moved with it.
dev/done/plan-3d-plot.md

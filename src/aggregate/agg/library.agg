agg CurveGenGamma
  1 claim
  sev 10000 * gengamma 2 1.5
  fixed
  note{Generalized (transformed) gamma, shapes a=2, c=1.5 -- nests gamma/Weibull/lognormal.}
  tags{topic:severity, role:reference};

agg CurveGumbel

# ======================================================================
# library.agg  --  the shipped DecL library
# ======================================================================
#
# Version: 2
#
# PURPOSE
# -------
# Library of educational, illustrative and testing examples.
#
# NAMES are descriptive and GLOBALLY UNIQUE across kinds, so `build('X')`
# and `build.recipe('X')` always mean the same entry and no `kind=`
# disambiguator is ever needed.
#
# THE TRAILER carries everything a tool reads. Comments are for humans
# only, nothing in src/aggregate parses them (the lexer deletes them
# before the grammar ever sees a line).
#
#   note{...}       one-line description. The aLL SPA dropdown blurb.
#   tags{...}       comma-separated slugs; grouping and
#                   selection (build.discover(tags=...)).
#   hints{...}      key=value; build settings, caller-wins.
#
# TAG VOCABULARY: namespaced.
#
# Tags never restate the object's TYPE. Type is what `kind` is for:
# build.discover(kind='sev') finds every severity object.
#
# Every tag carries a namespace:
#
#   topic:X   subject of the recipe, severity frequency aggregate
#             reinsurance economics portfolio spectral bivariate picks
#             tweedie numerics capstone, with bounds and ruin reserved. Independent of
#             type: an `agg` entry demonstrating a severity form is
#             topic:severity, and that is not a restatement. A topic is never
#             a kind token: topic:economics covers the `pnl` kind and
#             topic:spectral covers the `distortion` kind.
#   role:X    Every entry carries at least one role, and exactly one of:
#
#               intro         the very basic examples, the place to start.
#               intermediate  the teaching items, one idea each.
#               advanced      the practical and the awkward: reinsurance
#                             layering, picks, inner and outer aggregates,
#                             copulas, signed windows, grid edge cases.
#               reference     a lookup table entry, read rather than worked
#                             through: the severity curve block, the named
#                             building blocks.
#
#             Two markers may be added on top of the level, and neither is a
#             level of its own:
#
#               hero          it appears in the landing gallery, so it is
#                             built on demand and needs a sparkline. Keep the
#                             set small and keep diagnostics out of it.
#               published     it reproduces a published result. The citekey in
#                             the name says whose; this says that it is one.
#
# Enforced by tests/test_agg_libraries.py, a bare, un-namespaced tag fails.
#
#   build.discover(kind='sev')                        # by type
#   build.discover(tags='topic:severity')             # by subject
#   build.discover(tags='role:intro')                 # by level
#   build.discover(kind='agg', tags='topic:severity') # both
#
# PLACEMENT: on a `port`, the trailer goes on the `port` header line,
# a trailer written after the last unit binds to that unit, because the
# portfolio's trailer slot closes before the units are read.
#
# LAYOUT: the canonical `spread` form, one clause per line at a two-space
# indent, each statement closed by `;` and separated by a blank line.
# Not all entries round-trip: math expressions, array explosion, tower
# explosion, and recipe sev expansion.
# A `sev agg.NAME` reference is NOT in that set: the spec records the reference
# instead of inlining the object.
#
# ORDER is important: aLL Examples are in the input order in this file.
# The order goes starter examples, the capstone worked example, distortions,
# severity clause forms, the severity curve reference, frequency, aggregates,
# aggregates with reinsurance, an aggregate as a severity, bivariate,
# profit and loss, numerics, portfolios, and reproductions.
#
# Adding an entry means choosing where in the reading it belongs, not
# appending it to the end of a section.
#
# DecL is whitespace-insensitive, so a statement may be laid out however reads
# best. Only two things separate statements: a blank line, or a `;` at the end
# of a line. A comment never does.
# ======================================================================

# ----------------------------------------------------------------------
# Starter examples
# Dice, coins and the plain compound distributions. Everything here is
# exact or nearly so, which is what makes it the place to start.
# ----------------------------------------------------------------------

agg DiceOneDie
  dfreq [1 2 3 4 5 6]
  dsev [1]
  note{The roll of a single die.}
  tags{topic:aggregate, role:intro};

agg DiceOneDie.Sev
  dfreq [1]
  dsev [1 2 3 4 5 6]
  note{The roll of a single die, here as the severity rather than as the claim count.}
  tags{topic:aggregate, role:intro};

agg DiceTwoDice
  dfreq [2]
  dsev [1:6]
  note{Sum of the rolls of two dice. The dice using an array.}
  tags{topic:aggregate, role:intro};

agg DiceThreeEvenDice
  dfreq [3]
  dsev [2:12:2]
  note{Sum of three even-only dice using array with a step-size, exact discrete aggregate; zero validation error.}
  tags{topic:aggregate, role:intro};

agg DiceOfDice
  dfreq [1 2 3 4 5 6]
  dsev [1 2 3 4 5 6]
  note{Roll a die for the claim count, then sum that many die rolls. It is worth checking by hand; see https://blog.mynl.com/posts/notes/2026-08-11-dice-of-dice/index.html.}
  tags{topic:aggregate, topic:numerics, role:intro};

agg BasicRandomWalk
  dfreq [12]
  dsev [-1 1]
  note{A twelve step random walk, each step plus or minus one.}
  tags{topic:aggregate, role:intro};

agg BasicBiasedCoins
  dfreq [1000]
  dsev [0 1] [0.51 0.49]
  note{The number of heads in one thousand tosses of a slightly biased coin.}
  tags{topic:aggregate, role:intro};

agg BasicDfreq
  dfreq [1 2 3]
  dsev [1 2 10]
  note{One, two or three claims, all equally likely, with a severity of 1, 2 or 10, also equally likely.}
  tags{topic:aggregate, role:intro};

agg BasicDfreqWeighted
  dfreq [1 2 3] [0.5 0.25 0.25]
  dsev [1 2 10] [0.4 0.4 0.2]
  note{One, two or three claims and a severity of 1, 2 or 10, with both clauses carrying explicit probabilities.}
  tags{topic:aggregate, role:intro};

agg DiscreteBook
  dfreq [1 2 3 4 5 6 7 20]
  dsev [-10 -5 -2 -1 0 1 2 3] [0.0625 0.0625 0.125 0.125 0.125 0.25 0.125 0.125]
  note{A discrete example with signed severity, showing that an empirical distribution can be used directly.}
  tags{topic:aggregate, role:intro};

agg BasicBook
  250 claims
  1000 xs 0
  sev lognorm 100 cv 1.5
  poisson
  note{A basic realistic insurance book with Poisson frequency, lognormal severity and an occurrence limit. This is the workhorse compound distribution.}
  tags{topic:aggregate, role:hero, role:intro};

# ----------------------------------------------------------------------
# The capstone example
# A complete reinsurance pricing workflow, suitable for demoing to
# reinsurance actuaries: a gross book entered from a limit and attachment
# profile, exposure rating, layer loss picks, an XOL program, quota share
# variants with a sliding scale commission, and the P&L views. Entries
# build on one another by reference, so the terms are stated once.
# ----------------------------------------------------------------------

sev Capstone.Sev (250 / exp(1/2)) * lognorm 1
  note{Severity curve for the capstone example, lognormal with mean 250 and sigma=1.}
  tags{topic:capstone, role:advanced};

agg Capstone.Gross
  [2000 5000 10000 3000 1000] premium as GWP at [0.95 0.95 0.9 0.85 0.75] lr
  [500 1000 5000 10000 5000] xs [0 0 0 0 1000]
  sev.Capstone.Sev
  mixed gamma 0.125
  note{Capstone gross portfolio entered from a limit and attachment profile by premium and loss ratio. DRY: refer to the severity by name.}
  tags{topic:capstone, role:advanced};

agg Capstone.ExposureRating
  agg.Capstone.Gross
  occurrence ceded to
    tower [0 250 500 1000 2000 5000 10000]
  note{Exposure rating layering of the capstone example into 250 xs 0, 250 xs 250, 500 xs 500, 1000 xs 1000, 3000 xs 2000 and 5000 xs 5000 using the tower keyword. An intermediate step to view the layer exposure rating.}
  tags{topic:capstone, role:advanced};

agg Capstone.SelectedLosses
  [2000 5000 10000 3000 1000] premium as GWP at [0.95 0.95 0.9 0.85 0.75] lr
  [500 1000 5000 10000 5000] xs [0 0 0 0 1000]
  sev sev.Capstone.Sev
    picks [500 1000 2000 5000 10000] [14900 2250 1250 500 50]
  mixed gamma 0.125
  note{Aggregate built using an adjusted capstone severity curve to achieve the desired blended experience and exposure rating loss picks by layer. Note that to preserve the adjusted mean the sum of loss by layer must equal the original expected loss. Usually the actuary selects the excess layers and derives the bottom layer to preserve the mean.}
  tags{topic:capstone, role:advanced};

agg Capstone.LossPicksTest
  agg.Capstone.SelectedLosses
  occurrence ceded to
    tower [0 500 1000 2000 5000 10000]
  note{Throw-away test view to confirm the adjusted severity curve achieves the desired loss picks by layer.}
  tags{topic:capstone, role:advanced};

agg Capstone.XOL
  agg.Capstone.SelectedLosses
  occurrence net of
    50% po 500 xs 500 deposit 3000 as "500x500" and
    90% po 1000 xs 1000 deposit 1750 as "1x1" and
    95% po 3000 xs 2000 rol 25% as "3x2" and
    5000 xs 5000 rol 3% as "5x5"
  note{Apply the XOL program terms to the capstone book using the adjusted severity curve.}
  tags{topic:capstone, role:advanced};

xpnl Capstone.XOL.PnL
  derive premium
  less
    agg.Capstone.XOL
  less
    25% premium expenses as "G&A"
  peel bottom-up
  note{PnL (profit and loss) view of the capstone book with the XOL program only.}
  tags{topic:capstone, role:advanced};

agg Capstone.FullProgram
  agg.Capstone.XOL
  aggregate net of
    75% po inf xs 0 rate 100% cede 32.5% as QS
  note{Apply a quota share on the net book to the capstone account model, in addition to the XOL program.}
  tags{topic:capstone, role:advanced};

xpnl Capstone.PnL
  derive premium
  less
    agg.Capstone.FullProgram
  less
    25% premium expenses as "G&A"
  peel bottom-up
  note{PnL (profit and loss) view of the capstone book by program and layer.}
  tags{topic:capstone, role:advanced};

xpnl Capstone.PC
  derive premium
  less
    agg Capstone.Slide agg.Capstone.XOL
      aggregate net of
        75% po inf xs 0 rate 100% slide 0.48 at 0.42 and 0.38 at 0.62 and 0.18 at 0.82 as "QS w Slide"
  less
    25% premium expenses as "G&A"
  note{The final capstone model, adding a sliding scale commission to the quota share. The XOL program is pulled in by reference, ensuring all terms stay consistent. Look at Capstone.XOL.PnL to calibrate the slide: loss ratios net of XOL are broadly between 42% and 83%. Peel is not available in this case, but it would add nothing new.}
  tags{topic:capstone, role:advanced};

grossnet
  agg Capstone.GrossNet agg.Capstone.XOL
    note{Bivariate distribution of gross and net of XOL program losses for the capstone book. Also see grossceded and netceded.}
    tags{topic:capstone, topic:bivariate, role:advanced};

# ----------------------------------------------------------------------
# Distortions (risk measures)
# PHDistortion and DualDistortion come first: MinimumDistortion refers to
# them by name, and builtin references resolve by sequential load.
# Chosen to have equal gini_p coefficients equal to 0.2 using
#    from aggregate.spectral import consistent_distortions
#    d = consistent_distortions(0.2)   # dict keyed ccoc, ph, wang, dual, tvar
# ----------------------------------------------------------------------

distortion CCoCDistortion ccoc 0.25
  note{Constant cost of capital distortion, pricing to a 25% return on capital, which is a discount rate of 0.25 / 1.25 = 20%.}
  tags{topic:spectral, role:intro};

distortion PHDistortion ph 2/3
  note{Proportional hazard distortion with exponent 2/3, so g(s) = s**(2/3).}
  tags{topic:spectral, role:intro};

distortion WangDistortion wang 0.3582869092425833
  note{Wang transform, g(s) = Phi(Phi inverse of s, plus lambda), with lambda = 0.3583.}
  tags{topic:spectral, role:intermediate};

distortion DualDistortion dual 1.5
  note{Dual power distortion with exponent 1.5, and the second leaf of MinimumDistortion below.}
  tags{topic:spectral, role:intermediate};

distortion TVaRDistortion tvar 0.2
  note{TVaR distortion at p = 0.2, which prices as the average of the worst 80% of outcomes.}
  tags{topic:spectral, role:intro};

distortion MinimumDistortion minimum dist.PHDistortion dist.DualDistortion
  note{The minimum of two distortions is itself a distortion; here the minimum of PHDistortion and DualDistortion.}
  tags{topic:spectral, role:advanced};

distortion MixtureDistortion mixture dist.PHDistortion dist.DualDistortion wts [0.6 0.4]
  note{A weighted mixture of two distortions, itself a distortion. Weights are only meaningful for mixture: the other combinators, minimum among them, take the child list alone.}
  tags{topic:spectral, role:advanced};

# ----------------------------------------------------------------------
# Severity: the clause forms
# Each severity can be referenced by name using sev.name.
# ----------------------------------------------------------------------

sev UnitSeverity dsev [1]
  note{The severity identically equal to one, used to isolate a frequency distribution.}
  tags{topic:severity, role:reference};

sev MixedExponentialSev [10 50 200] * expon wts [0.6 0.3 0.1]
  note{A mixed exponential of the kind used by ISO and Verisk. It cannot be built as a Sev object on its own, so fold it into an agg with dfreq [1] to build it.}
  tags{topic:severity, role:reference};

sev CommAutoMixedExponentialSev [2764 24548 275654 1917469 10000000] * expon wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  note{A commercial auto mixed exponential severity, five components at the 2008 cost level, untrended, with mean 13,990. Parameters from Mildenhall, aggregate: Frequency-Severity Distributions Made Easy, Actuarial Review 50(3), pages 31 to 34, 2023, https://ar.casact.org/aggregate-frequency-severity-distributions-made-easy/.}
  tags{topic:severity, role:reference, role:published};

sev ParetoSev 1000 * pareto 1.8 + -1000
  note{A single parameter Pareto large loss curve (scale 1000, shape 1.8), shifted to ground up.}
  tags{topic:severity, role:reference};

sev ParetoSev.Lomax 1000 * lomax 1.8
  note{The same curve written as a Lomax, which is what the US Pareto is usually called; the shift to ground up is automatic.}
  tags{topic:severity, role:reference};

agg SevZeroParameter
  1 claim
  sev expon
  fixed
  note{An exponential with no scale, shift or shape parameter at all, the shortest severity clause DecL will accept.}
  tags{topic:severity, role:intro};

agg SevZeroParameterScaledShifted
  1 claim
  sev 100 * expon + 200
  fixed
  note{The same shapeless exponential, now scaled by 100 and shifted by 200.}
  tags{topic:severity, role:intro};

agg SevOneParameterScaled
  1 claim
  sev 10 * gamma 0.3
  fixed
  note{A scaled gamma, given by scale and shape.}
  tags{topic:severity, role:intro};

agg SevMeanCV
  1 claim
  sev gamma 12 cv 0.3
  fixed
  note{A gamma given by mean and cv rather than by scale and shape.}
  tags{topic:severity, role:intro};

agg SevTwoParameterScaledShifted
  1 claim
  sev 50 * beta 3 2 + 10
  fixed
  note{A beta with shapes 3 and 2, scaled by 50 and shifted by 10.}
  tags{topic:severity, role:intro};

agg SevLognormMeanCV
  1 claim
  sev lognorm 50 cv 0.3
  fixed
  note{A lognormal given by mean and cv.}
  tags{topic:severity, role:intro};

agg SevReversed
  1 claim
  ssev -(50 / exp(0.3**2/2)) * lognorm 0.3
  fixed
  note{Signed severity: a negative scale reflects the lognormal through zero, giving mean -50 and a cv reported as -0.3069, negative because the mean is negative.}
  tags{topic:severity, role:advanced};

agg SevMixture
  8 claims
  sev 100 * [lognorm expon] [0.5 1] wts [0.6 0.4]
  mixed gamma 0.3
  note{A mixture of severities, showing that every aspect of the severity clause can be mixed.}
  tags{topic:severity, role:intermediate};

agg EqualWeightMixture
  10 claims
  500 xs 0
  sev lognorm [20 40 100] cv [0.5 0.6 0.7] wts=3
  mixed gamma 0.2
  note{The equal-weight shorthand: wts=3 gives three components of weight one third each, a shorthand for the explicit list. The severity mean is their equally weighted average, before the 500 limit.}
  tags{topic:severity, role:intermediate};

agg SevSpliced
  1 claim
  sev lognorm 10 cv 1.5 splice [5 25]
  fixed
  note{A lognormal conditioned on 5 <= X <= 25.}
  tags{topic:severity, role:intermediate};

agg SplicedDisjointSegments
  1 claim
  sev lognorm [10 10] cv [1 1] wts [0.7 0.3] splice [2 10] [5 20]
  fixed
  note{A spliced severity on the disjoint segments [2, 5] and [10, 20]: the two-list splice form pairs each mixture component with its own bounds, conditioning the first onto [2, 5] with weight 0.7 and the second onto [10, 20] with weight 0.3, so no mass falls between the segments.}
  tags{topic:severity, role:advanced};

agg SevLayer
  1 claim
  20 xs 5
  sev lognorm 10 cv 0.5
  fixed
  note{Conditional severity, the default reading: the layer conditions on the loss exceeding the attachment of 5.}
  tags{topic:severity, role:intermediate};

agg SevLayer.Unconditional
  1 claim
  20 xs 5
  sev lognorm 10 cv 0.5 !
  fixed
  note{Unconditional severity: the trailing ! keeps losses below the attachment of 5 in the count as zeros, so the layer mean is lower than in the conditional reading.}
  tags{topic:severity, role:intermediate};

agg UnconditionalDiscreteSeverity
  5 claims
  4 xs 2
  dsev [1 2 3 4 5 6] !
  poisson
  note{The trailing ! makes the severity unconditional, so the five claims are ground-up claims and the two die faces below the attachment contribute nothing. Conditional is the default, where the count is of claims reaching the layer; the severity mean falls from 2.5 to 1.667 here.}
  tags{topic:severity, role:advanced};

agg MixedSeverityAndProfile
  [1000 2000 500] premium at [0.8 0.7 0.5] lr
  sev lognorm 10 cv [0.35 0.5] wts [0.625 0.375]
  mixed gamma 0.5
  note{Mixed exposure, severity and frequency. The shared mixing shows up in stats_df (More, then Stats in aLL), and the output has six components.}
  tags{topic:severity, role:advanced};

# ----------------------------------------------------------------------
# Severity curve reference
# The named families first, in alphabetical order for lookup, then the
# published parameterizations under their citekeys.
# ----------------------------------------------------------------------

agg CurveBeta
  1 claim
  sev 100000 * beta 2 5
  fixed
  note{Beta on [0, 100000], a bounded severity or destruction rate, with shapes a = 2 and b = 5.}
  tags{topic:severity, role:reference};

agg CurveBetaPrime
  1 claim
  sev 10000 * betaprime 3 4
  fixed
  note{Beta prime, also called the beta of the second kind (B2), the GB2 representative. See Cummins et al. (1990).}
  tags{topic:severity, role:reference};

agg CurveBurr12
  1 claim
  sev 10000 * burr12 3 1.2
  fixed
  note{Burr XII, also called Singh-Maddala (GB2 with p = 1), shapes c = 3 and d = 1.2.}
  tags{topic:severity, role:reference};

agg CurveBurrIII
  1 claim
  sev 10000 * burr 3 1.2
  fixed
  note{Burr III, also called Dagum (GB2 with q = 1), shapes c = 3 and d = 1.2.}
  tags{topic:severity, role:reference};

agg CurveExponential
  1 claim
  sev 10000 * expon
  fixed
  note{Exponential, with constant hazard and cv = 1. In scipy this is expon, whose scale is the mean.}
  tags{topic:severity, role:reference};

agg CurveFrechet
  1 claim
  sev 10000 * invweibull 3
  fixed
  note{Frechet, also called the inverse Weibull (type II extreme value), shape c = 3.}
  tags{topic:severity, role:reference};

agg CurveGEV
  1 claim
  sev 10000 * genextreme -0.2 + 20000
  fixed
  note{Generalized extreme value (GEV), shape -0.2, which puts it in the Frechet domain.}
  tags{topic:severity, role:reference};

agg CurveGPD
  1 claim
  sev 10000 * genpareto 0.3
  fixed
  note{Generalized Pareto (GPD), xi = 0.3, the peaks over threshold tail of extreme value theory.}
  tags{topic:severity, role:reference};

agg CurveGamma
  1 claim
  sev gamma 10000 cv 0.8
  fixed
  note{Gamma severity by mean and cv, so the shape is 1 / cv**2. See Klugman et al. and Parodi.}
  tags{topic:severity, role:reference};

agg CurveGenGamma
  1 claim
  sev 10000 * gengamma 2 1.5
  fixed
  note{Generalized (transformed) gamma, shapes a = 2 and c = 1.5, which nests the gamma, Weibull and lognormal.}
  tags{topic:severity, role:reference};

agg CurveGumbel
  1 claim
  sev 5000 * gumbel_r + 20000
  fixed
  note{Gumbel (type I extreme value), the block maxima law, with a light tail.}
  tags{topic:severity, role:reference};

agg CurveInverseGamma
  1 claim
  sev 10000 * invgamma 4.07
  fixed
  note{Inverse gamma, shape a = 4.07, with a heavy right tail. See Klugman et al.}
  tags{topic:severity, role:reference};

agg CurveInverseGaussian
  1 claim
  sev invgauss 10000 cv 0.7
  fixed
  note{Inverse Gaussian by mean and cv, right skewed and closely related to the Tweedie.}
  tags{topic:severity, role:reference};

agg CurveLogLogistic
  1 claim
  sev 10000 * fisk 2.5
  fixed
  note{Log-logistic, also called Fisk (GB2 with p = q = 1), shape c = 2.5.}
  tags{topic:severity, role:reference};

agg CurveLognormal
  1 claim
  sev lognorm 10000 cv 1.5
  fixed
  note{Lognormal by mean and cv, the default working severity.}
  tags{topic:severity, role:reference};

agg CurveLomax
  1 claim
  sev 10000 * lomax 2.5
  fixed
  note{Lomax, also called Pareto Type II or the shifted Pareto, alpha = 2.5.}
  tags{topic:severity, role:reference};

agg CurvePareto
  1 claim
  sev 10000 * pareto 2.5 + -10000
  fixed
  note{Pareto Type I, the European Pareto, alpha = 2.5, shifted to ground up.}
  tags{topic:severity, role:reference};

agg CurveWeibull
  1 claim
  sev 10000 * weibull_min 1.5
  fixed
  note{Weibull (scipy weibull_min), shape c = 1.5, with increasing hazard.}
  tags{topic:severity, role:reference};

sev Berens1997.Lognorm lognorm 150000 cv 0.25
  note{Lognormal severity, mean 150,000 and cv 0.25, from Berens (1997).}
  tags{topic:severity, role:reference, role:published};

sev Berens1997.Pareto 50000 * pareto 1.5
  note{Pareto severity, scale 50,000 and shape 1.5, from Berens (1997).}
  tags{topic:severity, role:reference, role:published};

sev Bodoff2017.Pareto 50000 * lomax 1.5
  note{Lomax severity, scale 50,000 and shape 1.5, from Bodoff (2017).}
  tags{topic:severity, role:reference, role:published};

sev Jin2016.Gamma gamma 6 cv 0.5774
  note{Gamma severity, mean 6 and cv 0.5774, from Jin (2016).}
  tags{topic:severity, role:reference, role:published};

sev Jin2016.Pareto 100 * lomax 20
  note{Lomax severity, scale 100 and shape 20, from Jin (2016).}
  tags{topic:severity, role:reference, role:published};

sev Kang2019.Pareto 3.5 * lomax 3.5
  note{Lomax severity, scale 3.5 and shape 3.5, from Kang (2019).}
  tags{topic:severity, role:reference, role:published};

sev Mack2003.AmericanPareto 10000 * lomax 1.5
  note{The American Pareto, scale 10,000 and shape 1.5, from Mack (2003).}
  tags{topic:severity, role:reference, role:published};

sev Mack2003.Lognorm lognorm 10000 cv 4.953
  note{Lognormal severity, mean 10,000 and cv 4.953, from Mack (2003).}
  tags{topic:severity, role:reference, role:published};

sev Mack2003.RiebesellPareto 10000 * lomax 0.737
  note{The Riebesell Pareto, scale 10,000 and shape 0.737, from Mack (2003).}
  tags{topic:severity, role:reference, role:published};

sev Mata2005.Lognorm 11048 * lognorm 2.29
  note{Lognormal severity, scale 11,048 and sigma 2.29, from Mata (2005).}
  tags{topic:severity, role:reference, role:published};

sev Venter1983.Piecewise chistogram xps [0 1000 5000 6000 7000 8000 9000 10000 12500 15000 17500 20000 25000 35000 50000 75000 100000 125000 150000 175000 200000 225000 250000 300000] [0.38935 0.38935 0.00568 0.00543 0.00517 0.00495 0.00473 0.01098 0.00989 0.00896 0.00815 0.01426 0.02237 0.02353 0.02459 0.01517 0.01021 0.00732 0.00547 0.00423 0.00337 0.00274 0.0241]
  note{A piecewise linear claim size CDF to the 250,000 policy limit, from Venter (1983). The top bin carries the limit mass, so use it only inside a 250000 xs 0 layer.}
  tags{topic:severity, role:reference, role:published};

# ----------------------------------------------------------------------
# Frequency
# One law per entry, most on the unit severity so only the count varies.
# ----------------------------------------------------------------------

agg FixedFrequency
  10 claims
  dsev [1]
  fixed
  note{A fixed claim count of exactly ten.}
  tags{topic:frequency, role:intro};

agg BernoulliFrequency
  0.8 claims
  dsev [1]
  bernoulli
  note{Bernoulli claim count with p = 0.8, so either no claim or one claim.}
  tags{topic:frequency, role:intro};

agg BinomialFrequency
  10 claims
  dsev [1]
  binomial 0.5
  note{Binomial claim count with mean 10 and p = 0.5, so n = 20 is computed automatically and the standard deviation is (20 / 4)**0.5 = 2.236.}
  tags{topic:frequency, role:intro};

agg PoissonSimple
  10 claims
  dsev [1]
  poisson
  note{Poisson claim count with mean 10.}
  tags{topic:frequency, role:intro};

agg GeometricFrequency
  10 claims
  dsev [1]
  geometric
  note{Geometric claim count, the number of failures before the first success in Bernoulli(p) trials, with mean n = (1 - p) / p. It is parameterized by n rather than by p. The variance is (1 - p) / p**2 = n(n + 1), so the cv is sqrt((n + 1) / n), which tends to 1 for large n.}
  tags{topic:frequency, role:intermediate};

agg NegativeBinomialFrequency
  10 claims
  dsev [1]
  negbin 3
  note{Negative binomial claim count, where the shape parameter 3 is the variance multiplier.}
  tags{topic:frequency, role:intermediate};

agg NegativeBinomialMixed
  10 claims
  dsev [1]
  mixed gamma 0.65
  note{Negative binomial written as a gamma mixed Poisson, where the shape parameter is the cv of the mixing distribution.}
  tags{topic:frequency, role:intermediate};

agg InverseGaussianMixed
  10 claims
  dsev [1]
  mixed ig 0.65
  note{An inverse Gaussian mixing distribution, where the shape parameter is the cv of the mixing distribution.}
  tags{topic:frequency, role:intermediate};

agg DelaporteMixedFrequency
  10 claims
  dsev [1]
  mixed delaporte 0.65 0.25
  note{A two-parameter mixing law: the Delaporte is a shifted gamma mixed Poisson, taking the mixing cv and the shift. sig and sichel take two parameters in the same position.}
  tags{topic:frequency, role:advanced};

agg ZTPoissonFrequency
  4 claims
  dsev [1]
  poisson zt !
  note{Zero-truncated Poisson, so there is always at least one claim and E[N] = 4 / (1 - exp(-4)) = 4.0746.}
  tags{topic:frequency, role:advanced};

agg ZMPoissonFrequency
  4 claims
  dsev [1]
  poisson zm 0.5 !
  note{Zero-modified Poisson, inflating the no-claim probability to 0.5. The trailing ! reads the 4 as the unmodified base mean, so reweighting leaves E[N] = 2.0373. Drop the ! to pin E[N] = 4 instead.}
  tags{topic:frequency, role:advanced};

agg ZMPoissonFrequency.Mean
  4 claims
  dsev [1]
  poisson zm 0.5
  note{Zero-modified Poisson, inflating the no-claim probability to 0.5 while retaining a mean of 4.}
  tags{topic:frequency, role:advanced};

agg NeymanAFrequency
  10 claims
  dsev [1]
  neymana 4
  note{Neyman Type A claim count: a Poisson number of clusters, each contributing a Poisson number of claims. The parameter is the mean cluster size, so 10 claims in clusters of 4 means 2.5 clusters on average.}
  tags{topic:frequency, role:advanced};

agg PascalFrequency
  10 claims
  dsev [1]
  pascal 0.8 3
  note{A two-parameter frequency: the Pascal, a Poisson stopped sum of negative binomials, taking a contagion and a claims-per-occurrence parameter.}
  tags{topic:frequency, role:advanced};

# Renewal (Sparre Andersen) frequency: a `years` exposure paired with a
# waiting-time law. The wait clause takes the whole severity mini-language,
# written on the time axis; dwait mirrors dsev.

agg RenewalExponentialWait
  10 years
  dsev [1]
  wait expon
  note{Renewal frequency: claims arrive over a ten year exposure with exponential waiting times of mean one, which reproduces 10 claims dsev [1] poisson exactly. The wait clause takes the whole severity mini-language, so a waiting time is written like any other distribution, on the time axis.}
  tags{topic:frequency, role:advanced};

agg RenewalGammaWait
  5 years
  dsev [1]
  wait gamma 2
  note{Erlang waiting times, shape two and mean two, over a five year exposure, giving an expected count of 2.25. Non-exponential waits are what separate a renewal count from a Poisson one.}
  tags{topic:frequency, role:advanced};

agg RenewalDeterministicWait
  3 years
  dsev [1]
  dwait [1]
  note{Deterministic unit waits over three years, so the count is exactly three: the arrival falling on the horizon counts. dwait mirrors dsev, taking outcomes and probabilities.}
  tags{topic:frequency, role:advanced};

agg RenewalDefectiveWait
  2 years
  dsev [1]
  dwait [1 2] [0.4 0.5] !
  note{A defective, terminating renewal process: the wait probabilities sum to 0.9, so with probability 0.1 no further claim ever arrives and the expected count falls to 1.06. The trailing ! is what permits the defect.}
  tags{topic:frequency, role:advanced};

agg RenewalLayeredWait
  5 years
  dsev [1]
  wait 2 xs 1 expon
  note{The layered wait form applies the severity layer transform to the waiting time, here conditional on the wait exceeding one and capped two above it, lifting the expected count to 5.58. Add ! for the unconditional reading, where waits below the attachment collapse to a zero-wait cluster.}
  tags{topic:frequency, role:advanced};

# ----------------------------------------------------------------------
# Aggregates
# Exposure can be stated as a claim count, a loss amount, premium times a
# loss ratio, or exposure times a unit rate. Premium can be appended as an
# informational item. Also here: limits profile blends and the Tweedie family.
# ----------------------------------------------------------------------

agg ExposureByClaimCount
  10 claims
  sev lognorm 50 cv 0.8
  poisson
  note{Exposure stated as a number of claims.}
  tags{topic:aggregate, role:intro};

agg ExposureByLoss
  500 loss 800 premium
  sev lognorm 50 cv 0.8
  poisson
  note{Exposure stated as expected loss, from which the claim count is derived. The premium is informational only.}
  tags{topic:aggregate, role:intro};

agg ExposureByPremium
  1000 premium at 0.5 lr
  sev lognorm 50 cv 0.8
  poisson
  note{Exposure stated as premium and a loss ratio, from which the claim count is derived.}
  tags{topic:aggregate, role:intro};

agg ExposureRatedPolicy
  10000 exposure at 0.125 rate
  250 xs 0
  sev lognorm 40 cv 1.5
  poisson
  note{The exposure-rated exposure clause: expected loss is exposure times rate, 10_000 at 0.125 for a loss pick of 1_250, and the claim count is derived from the severity. The spec records it exactly as premium at lr does, so the spelling does not survive a reformat.}
  tags{topic:aggregate, role:intermediate};

agg ExposureLimitProfile
  [10_000 20_000 5_000 5_000] premium at [0.8 0.7 0.6 0.5] lr
  [1_000 2_000 5_000 5_000] xs [0 0 0 250]
  sev lognorm 150 cv 1.5
  poisson
  note{A premium by limit by loss ratio profile, with the implied claim count computed for each band.}
  tags{topic:aggregate, role:hero, role:advanced};

agg TowerLimitProfile
  1 claim
  tower [0 100 250 500]
  sev lognorm 100 cv 3
  fixed
  note{A tower written in the policy limit position rather than the reinsurance one, expanding to the three consecutive layers 100 xs 0, 150 xs 100 and 250 xs 250.}
  tags{topic:aggregate, role:intermediate};

agg TweedieDirect
  tweedie 1.1 100 1.5
  note{Tweedie defined by p, mean and dispersion with the tweedie keyword, so the variance is dispersion * mean**p. Use the tweedie_convert method to translate the parameters.}
  tags{topic:aggregate, topic:tweedie, role:intermediate};

agg TweedieFromMoments
  100**(2-1.1)/((2-1.1)*1.5) claims
  sev gamma (1.5*(2-1.1)*100**(1.1-1)) cv ((1.1-1)/(2-1.1))**0.5
  poisson
  note{Tweedie defined by claim count and gamma mean and cv, with every number written as DecL arithmetic in the p = 1.1, mean = 100 and dispersion = 1.5 of TweedieDirect.}
  tags{topic:aggregate, topic:tweedie, role:intermediate};

agg TweedieFreqSev
  100**(2-1.1)/((2-1.1)*1.5) claims
  sev (1.5*(1.1-1)*100**(1.1-1)) * gamma ((2-1.1)/(1.1-1))
  poisson
  note{Tweedie defined by claim count and gamma scale and shape, with every number written as DecL arithmetic in the p = 1.1, mean = 100 and dispersion = 1.5 of TweedieDirect.}
  tags{topic:aggregate, topic:tweedie, role:intermediate};

agg TweedieMultiModal
    tweedie 1.005 1.0 0.1
    note{An extreme Tweedie with p very close to 1 behaves like a Poisson and has a highly multimodal density.}
    tags{topic:aggregate, topic:tweedie, role:advanced};

# ----------------------------------------------------------------------
# Aggregates with reinsurance
# GrossCatXOL is the gross view of the USXOLTower program that follows it.
# ----------------------------------------------------------------------

agg GrossCatXOL as "Gross US Hurricane"
  1.74 claims
  sev lognorm 8.501 cv 14.624
  poisson
  note{An industry loss warranty model of US catastrophe risk, amounts in billions. This is the gross view of the USXOLTower program.}
  tags{topic:aggregate, topic:reinsurance, role:advanced}
  hints{bs=2;log2=16;normalize=False;};

agg USXOLTower as "US Hurricane Reinsurance"
  1.74 claims
  sev lognorm 8.501 cv 14.624
  occurrence net of
    90% po 100 xs 100 deposit 4 and
    95% po 200 xs 200 deposit 3.75 as "Occ re"
  poisson
  aggregate net of
    50% po 20 xs 100 deposit 3 as "Agg re"
  note{An industry loss warranty model of US catastrophe risk, amounts in billions, from the St John's RMI 3388 course. Industry estimates as of 2019 put the 100 year PML at USD 132.5B and the 250 year at USD 300.3B.}
  tags{topic:reinsurance, role:hero, role:advanced}
  hints{bs=2;log2=16;normalize=False;};

agg OccurrenceXOL
  100 claims
  1_000 xs 0
  sev lognorm 100 cv 2
  occurrence net of
    90% po 875 xs 125
  poisson
  note{An occurrence excess of loss program, partially placed at 90%.}
  tags{topic:reinsurance, role:intermediate};

agg AggregateStopLoss
  100 claims
  1_000 xs 0
  sev lognorm 100 cv 2
  poisson
  aggregate net of
    1930 xs 9870
  note{An aggregate stop loss attaching at the 60th percentile of the gross book and detaching at the 90th.}
  tags{topic:reinsurance, role:intermediate};

agg OccurrenceXOLProgram
  15 claims
  10_000 xs 0
  sev lognorm 1500 cv 3
  occurrence net of
    50% po 2500 xs 2500 and
    90% po 5000 xs 5000
  mixed gamma 0.25
  note{A two layer occurrence excess of loss program, seen net.}
  tags{topic:reinsurance, role:advanced};

agg ReinsuranceOccurrenceTower
  dfreq [1]
  sev 125 * uniform
  occurrence ceded to tower [0 25 50 75 100 125]
  note{An occurrence reinsurance tower on a single claim. Look at Reinsurance, then Stats in aLL to see the layer losses.}
  tags{topic:reinsurance, role:advanced};

agg ReinsuranceOccurrenceTower.Agg
  10 claims
  sev 125 * uniform
  occurrence ceded to tower [0 25 50 75 100 125]
  poisson
  note{The same occurrence reinsurance tower, this time inside an aggregate book.}
  tags{topic:reinsurance, role:advanced};

agg ReinsuranceOccurrenceWithAggLimit
  5 claims
  120 xs 0
  sev 120 * uniform
  occurrence ceded to
    60 xs 60
  poisson
  aggregate ceded to
    180 xs 0
  note{An occurrence program capped by an aggregate limit.}
  tags{topic:reinsurance, role:advanced};

agg ReinsuranceLayered
  1250 premium at 0.8 lr
  1000 xs 0
  sev lognorm 80 cv 1.675
  occurrence ceded to
    125 xs 0 and
    50% po 125 xs 125 and
    20% po 250 xs 250 and
    5% po 500 xs 500
  poisson
  note{A layered occurrence reinsurance tower with partial placements, seen ceded.}
  tags{topic:reinsurance, role:advanced};

agg ReinsuranceExposureRating
  [10000 20000 10000 5000] premium at [0.9 0.85 0.9 0.8] lr
  [250 500 1000 2000] xs 0
  sev lognorm 120 cv 5
  occurrence ceded to
    500 xs 500 and
    1000 xs 1000
  mixed gamma 0.2
  note{Exposure rating on a small portfolio with a limits profile, amounts in 000s.}
  tags{topic:reinsurance, role:hero, role:advanced}
  hints{log2=16; bs=2};

agg ReinsuranceExposureRating.Check
  5000 premium at 0.8 lr
  2000 xs 0
  sev lognorm 120 cv 5
  occurrence ceded to
    500 xs 500 and
    1000 xs 1000
  mixed gamma 0.2
  note{A check on the top layer of ReinsuranceExposureRating, which only the 2000 limit band exposes.}
  tags{topic:reinsurance, role:advanced}
  hints{log2=16; bs=2};

agg LayerPicks.Uniform
  dfreq [1]
  sev 100 * uniform picks [50 75 100] [30 12 5]
  note{Layer loss picks: the severity curve is adjusted to match the selected picks by layer, which moves the mean with it.}
  tags{topic:reinsurance, topic:picks, role:advanced}

agg LayerPicks.Lognorm.Exposure
  dfreq [1]
  1000 xs 0
  sev (100 / exp(1.5**2/2)) * lognorm 1.5
  occurrence ceded to tower [0 125 250 500 1000]
  note{Exposure rating by layer. Look at Reinsurance, then Summary for the loss picks by layer.}
  tags{topic:reinsurance, topic:picks, role:advanced}

agg LayerPicks.Lognorm.Experience
  dfreq [1]
  1000 xs 0
  sev (100 / exp(1.5**2/2)) * lognorm 1.5
      picks [125 250 500 1000] [30 20 20 18]
  occurrence ceded to tower [0 125 250 500 1000]
  note{Layer loss picks with a fairly extreme adjustment. Run it with ceded to tower [0 100 200 500] to recover the loss picks by layer.}
  tags{topic:reinsurance, topic:picks, role:advanced}

port LayerPicks.Compare
  note{Compares picked and unpicked severity as two units of one portfolio.}
  tags{topic:reinsurance, topic:picks, role:advanced}
  agg LayerPicks.Lognorm.Exposure
    dfreq [1]
    1000 xs 0
    sev (100 / exp(1.5**2/2)) * lognorm 1.5
  agg LayerPicks.Lognorm.Experience
    dfreq [1]
    1000 xs 0
    sev (100 / exp(1.5**2/2)) * lognorm 1.5
      picks [125 250 500 1000] [30 20 20 18]

agg CommAuto.Exposure
  1 claim
  sev [2764 24548 275654 1917469 10000000] * expon wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  occurrence ceded to tower [0 100000 250000 500000 1000000 5000000]
  fixed
  note{Layer loss picks. This must be written 1 claim ... fixed, because dfreq is one fixed count whereas fixed is a family of fixed distributions.}
  tags{topic:reinsurance, topic:picks, role:advanced}
  hints{bs=125; log2=18};

agg CommAuto.WithPicks
  1 claim
  sev [2764 24548 275654 1917469 10000000] * expon wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  picks [100000 250000 500000 1000000 5000000] [7000 1500 1500 1500 2250]
  occurrence ceded to tower [0 100000 250000 500000 1000000 5000000]
  fixed
  note{Layer loss picks: the CommAutoMixedExponentialSev curve reweighted to hit the chosen picks.}
  tags{topic:reinsurance, topic:picks, role:advanced}
  hints{bs=125; log2=18};

# Reinsurance economics: premium forms (rate, deposit, rol), ceding
# commissions, reinstatements and the variable features (swing, retro,
# slide, profit commission, corridor), shown through the P&L lens.
# VariableFeature.Base is the shared book the variable features wrap.

xpnl CedingCommission
  inherit premium
  less
    agg CedingCommission.Book
      10000 premium at 0.7 lr
      2000 xs 0
      sev lognorm 150 cv 2.5
      occurrence net of
        1750 xs 250 rate 0.325 cede 0.1 as "Occ Re"
      mixed gamma 0.25
  less
    2000 fixed expenses as Expenses
  note{Ceded premium as a rate on the gross premium, with a 10% ceding commission returned on it. rate is the third premium form beside deposit and rol, and cede is only valid alongside a premium; the layer is entered gross of commission.}
  tags{topic:reinsurance, role:advanced};

xpnl ReinstatementTreaty
  10000 premium
  less
    agg ReinstatementTreaty.Book
      10000 premium at 0.9 lr
      20000 xs 0
      sev 1500 * lomax 1.5
      occurrence net of
        18000 xs 2000 rol 0.275 reinstatements 1 free and 2 at 100% as Cat
      mixed gamma 0.25
  note{The treaty-language reinstatement schedule: one free reinstatement then two at the full base rate on line, so the cover runs to four annual limits. It builds the same schedule as the explicit multiplier list [0 1 1].}
  tags{topic:reinsurance, role:advanced};

xpnl NoReinstatementTreaty
  10000 premium
  less
    agg NoReinstatementTreaty.Book
      10000 premium at 0.9 lr
      20000 xs 0
      sev 1500 * lomax 1.5
      occurrence net of
        18000 xs 2000 rol 0.275 no reinstatements as Cat
      mixed gamma 0.25
  note{Zero reinstatements: a single annual limit, recovery capped there and no reinstatement premium, so the ceded premium stays deterministic. This is distinct from omitting the clause, which leaves the cover free and unlimited.}
  tags{topic:reinsurance, role:advanced};

xpnl ReinstatementNumberWords
  10000 premium
  less
    agg ReinstatementNumberWords.Book
      10000 premium at 0.9 lr
      20000 xs 0
      sev 1500 * lomax 1.5
      occurrence net of
        18000 xs 2000 rol 0.275 reinstatements one free and three at 100% as Cat
      mixed gamma 0.25
  note{Reinstatement counts written as number words rather than digits. The words one to five are read as counts only in this position, so they stay ordinary identifiers everywhere else.}
  tags{topic:reinsurance, role:advanced};

agg VariableFeature.Base
  10000 premium at 0.9 lr
  2000 xs 0
  sev lognorm 150 cv 2.5
  mixed gamma 0.25
  note{The shared base book for the variable-feature entries: swing, retro and sliding scale each wrap this same aggregate by reference.}
  tags{topic:reinsurance, role:reference};

xpnl SwingRatedAggCover
  10000 premium
  less
    agg SwingRated agg.VariableFeature.Base
      aggregate net of
        5000 xs 8000 swing basic 300 lcm 1.1 min 1000 max 3000 as "Agg XOL"
  note{Swing rating: the ceded premium is a collared affine function of ceded loss, clip(basic + lcm * ceded, min, max). Swing replaces the deposit, rol or rate clause rather than decorating it.}
  tags{topic:reinsurance, role:advanced};

pnl RetroRatedAccount
  retro basic 500 lcm 1.05 min 6000 max 13000 premium
  less
    agg RetroRated agg.VariableFeature.Base
  note{Retrospective rating: the account-level clause that varies the gross premium with the account loss, replacing the fixed premium head. Retro currently requires a book with no inuring reinsurance, the one-dimensional case where net account loss equals gross loss. xpnl is not available for retro rating.}
  tags{topic:reinsurance, role:advanced};

xpnl SlidingScaleCommission
  12000 premium
  less
    agg SlidingScale agg.VariableFeature.Base
      aggregate net of
        80% po inf xs 0 rate 100% slide 0.32 at 0.6 and 0.22 at 0.7 and 0.17 at 0.8 as "QS+slide"
  less
    22.5% premium expenses as Expenses
  note{Sliding scale commission: the ceding commission slides down the anchors as the ceded loss ratio rises, interpolating between them and flat outside. Slide replaces the cede clause and needs a base premium to form the ratio.}
  tags{topic:reinsurance, role:advanced};

xpnl ProfitCommission
  inherit premium
  less
    agg ProfitCommission.Book
      10000 premium at 0.9 lr
      2000 xs 0
      sev lognorm 150 cv 2.5
      mixed gamma 0.25
      aggregate net of
        80% po inf xs 0 rate 1 pc 0.35 after 0.1 as "QS + P/C"
  note{Profit commission: the reinsurer returns 35% of the profit remaining after a 10% expense allowance, so the credit is share * (1 - ceded loss ratio - allowance) of ceded premium, floored at zero. Net of expense calculation.}
  tags{topic:reinsurance, role:advanced};

xpnl LossCorridor
  inherit premium
  less
    agg LossCorridor.Book
      10000 premium at 0.7 lr
      2000 xs 0
      sev lognorm 150 cv 2.5
      mixed gamma 0.25
      aggregate net of
        80% po inf xs 0 rate 0.8 corridor 0.5 po 0.4 xs 0.5 as "QS+Corridor"
  less
    0.2 premium expenses as Expenses
  note{Loss corridor: the cedant takes back half of the ceded loss in a ratio band running 40 points excess of 50%, so the recovery flattens across the corridor and resumes above it. The band is written with the layer words po and xs. Net quota share with no cede.}
  tags{topic:reinsurance, role:advanced};


# ----------------------------------------------------------------------
# Inner/outer aggregates: one aggregate as the severity of another.
# Each pair is inner then outer, and the inner must come first: the outer
# records `sev agg.NAME` at parse time and the underwriter resolves it
# when the outer is built.
# ----------------------------------------------------------------------

agg NeymanCluster
  4 claims
  dsev [1]
  poisson
  note{One cluster of a Neyman Type A: a Poisson(4) count on a unit severity. This is the inner half of the construction NeymanInnerOuter assembles.}
  tags{topic:frequency, role:advanced}
  hints{bs=1; log2=8};

agg NeymanInnerOuter
  2.5 claims
  sev agg.NeymanCluster
  poisson
  note{Neyman Type A assembled by hand: a Poisson(2.5) number of NeymanCluster draws, overall mean 10. The same distribution as NeymanAFrequency.}
  tags{topic:frequency, role:advanced}
  hints{bs=1; log2=10};

agg SplitLimitClaimant
  1.25 claims
  100 xs 0
  sev lognorm 50 cv 2
  poisson zt
  note{Claimants in one US auto 100/300 split limit accident: at least one claimant, 1.25 on average, each capped at the 100 per claimant limit. The count is a zero-truncated Poisson, reparameterized to achieve the desired mean.}
  tags{topic:frequency, topic:severity, role:advanced}
  hints{bs=1/4; log2=13};

agg SplitLimitPolicy
  100 claims
  300 xs 0
  sev agg.SplitLimitClaimant
  poisson
  note{100 US auto policies written 100/300: the per accident loss of SplitLimitClaimant is the severity, capped at the 300 per accident limit.}
  tags{topic:aggregate, topic:severity, role:advanced}
  hints{bs=1/4; log2=17};

# ----------------------------------------------------------------------
# Bivariate and dependent risks
# By copula first, then the common-shock pair, the joint gross / ceded /
# net views of a reinsurance program, the clash model and the discrete
# bivariate severities.
# ----------------------------------------------------------------------

bivariate BivariateIndependent
  25 claims
  agg A
    dfreq [1]
    ssev lognorm 50 cv 0.25 - 25
  agg B
    dfreq [1]
    ssev gamma 50 cv 0.25 - 25
  copula independent
  poisson
  note{A bivariate aggregate whose two independent units each have positive and negative support.}
  tags{topic:bivariate, role:intermediate};

bivariate BivariateNormal
  25 claims
  agg A
    dfreq [1]
    sev lognorm 50 cv 1.5
  agg B
    dfreq [1]
    sev gamma 50 cv 1
  copula normal 0.5
  poisson
  note{Normal copula dependence, correlation 0.5, between a lognormal and a gamma unit.}
  tags{topic:bivariate, role:advanced};

bivariate BivariateClaytonMixed
  25 claims
  agg Wind
    dfreq [0 1] [0.3 0.7]
    sev lognorm 40 cv 1.2
  agg Flood
    dfreq [0 1] [0.2 0.8]
    sev lognorm 60 cv 1.5
  copula clayton 0.3
  mixed gamma 0.2
  note{Clayton copula dependence between Wind and Flood, with gamma mixed frequency, so lower tail dependence sits on top of a shared shock.}
  tags{topic:bivariate, role:advanced};

bivariate BivariateGumbel
  25 claims
  agg Wind
    dfreq [0 1] [0.3 0.7]
    sev lognorm 40 cv 1.2
  agg Flood
    dfreq [0 1] [0.1 0.9]
    sev lognorm 60 cv 1.5
  copula gumbel 0.4
  poisson
  note{Gumbel copula dependence between the Wind and Flood units.}
  tags{topic:bivariate, role:hero, role:advanced};

bivariate BivariateCatPair
  25 claims
  agg Wind
    dfreq [0 1] [0.3 0.7]
    sev lognorm 40 cv 0.65 splice [0 250]
  agg Flood
    dfreq [0 1] [0.1 0.9]
    sev lognorm 60 cv 0.95 splice [0 300]
  copula independent
  mixed gamma 0.2
  note{A common shock bivariate: the Wind and Flood units share one frequency mixing variable.}
  tags{topic:bivariate, role:advanced};

agg BivariateOccReBase
  8 claims
  sev 300 * beta 2 3
  occurrence net of
    50% po 250 xs 50
  poisson
  note{The base excess of loss program for the three joint views that follow, each of which wraps it by reference.}
  tags{topic:bivariate, topic:reinsurance, role:reference};

grossnet
  agg BivariateGrossNet agg.BivariateOccReBase
    note{The joint distribution of gross and net for an excess of loss program. The three view prefixes name the axes in order: netceded, grossceded and grossnet.}
    tags{topic:bivariate, topic:reinsurance, role:advanced};

grossceded
  agg BivariateGrossCeded agg.BivariateOccReBase
    note{The joint distribution of gross and ceded for the same program, the view that shows how much of a bad gross year the treaty actually pays.}
    tags{topic:bivariate, topic:reinsurance, role:advanced};

netceded
  agg BivariateNetCeded agg.BivariateOccReBase
    note{The joint distribution of net and ceded for the same excess of loss program.}
    tags{topic:bivariate, topic:reinsurance, role:advanced};

netceded
  agg BivariateNetCededPair
    15 claims
    10000 xs 0
    sev lognorm 1500 cv 1
    occurrence net of
      50% po 2500 xs 2500 and
      90% po 5000 xs 5000
    mixed gamma 0.25
    note{The joint gross, ceded and net view of a reinsured book.}
    tags{topic:bivariate, topic:reinsurance, role:advanced};

clash BivariateClash
  8 5 2 claims
  sev lognorm 50 cv 0.6
  sev lognorm 60 cv 0.8
  mixed gamma 0.2
  note{A shared-event clash model: 8 claims are A only, 5 are B only, and 2 are both, and the solver derives the shared frequency and the per-event triggers, so the two components become Bernoulli factories on one common count.}
  tags{topic:bivariate, role:advanced};

bivariate BivariateDiscreteJoint
  dfreq [1 5 20] [0.5 0.25 0.25]
  dbvsev [1 2 3] [1 2 3] [[0.1875 0.125 0] [0.125 0.125 0.125] [0 0.125 0.1875]]
  note{Discrete bivariate severity, the two-dimensional analogue of dsev: the joint per-claim probability matrix is given directly on an explicit lattice, row index the X outcome and column index the Y outcome. The marginals reproduce the standalone dsev compounds exactly.}
  tags{topic:bivariate, role:advanced};

bivariate BivariateDiscreteSparse
  5 claims
  dbvsev [[10 1 0.4] [10 2 0.1] [20 1 0.2] [20 2 0.15] [1 50 0.15]]
  fixed
  note{The sparse specification of dbvsev: outcome, outcome and probability triples, which reads better than a dense matrix when most of the joint lattice is empty. It expands to the dense form on Reformat, which is why it does not round-trip. Enjoy on log scale!}
  tags{topic:bivariate, role:advanced};

# ----------------------------------------------------------------------
# Profit and loss (signed support)
# The premium forms first, then the expense forms, then the payoff
# orientation and the signed-support entries.
# ----------------------------------------------------------------------

pnl PnLSimple
  inherit premium
  less
    agg PnL.A
      1000 premium at 0.9 lr
      1000 xs 0
      sev lognorm 120 cv 1
      mixed gamma 0.25
  note{A single profit and loss line, with the premium inherited from the unit.}
  tags{topic:economics, role:intro};

pnl PnLClaims
  100 premium
  less
    agg PnL.B
      10 claims
      sev lognorm 8 cv 1.5
      poisson
  note{The claims form, where the premium is stated independently of the loss model.}
  tags{topic:economics, role:intro};

pnl PnLLoss
  100 premium
  less
    agg PnL.C
      85 loss
      sev lognorm 8 cv 1.5
      poisson
  note{The expected loss form, with E[loss] = 85 and a margin of 15.}
  tags{topic:economics, role:intro};

pnl PnLLossRatio
  1000 premium
  less
    agg PnL.D
      1000 premium at 0.7 lr
      sev lognorm 100 cv 2
      poisson
  note{The loss ratio form, with E[loss] = 700 and a margin of 300.}
  tags{topic:economics, role:intro};

pnl PnLVector
  [100 200 100] premium
  less
    agg PnL.E
      [100 200 100] premium at 0.8 lr
      [1000 2000 5000] xs 0
      sev lognorm 500 cv 2
      poisson
  note{Vector premium, giving a shift of 400 and a mean of 80, the sum of premium_i (1 - lr_i).}
  tags{topic:economics, role:intermediate};

xpnl PnLExpenses
  10000 premium as GWP
  less
    agg Book.Agg.1
      6500 loss
      1000 xs 0
      sev lognorm 100 cv 2
      mixed ig 0.25
  less
    500 fixed expenses as Fees 0.15 premium expenses as Commission 0.1 loss expenses as LAE
  note{Explicitly specify premium in the pnl clause. A list of expenses appears as separate line items.}
  tags{topic:economics, role:advanced};

xpnl PnLInherit
  inherit premium as GWP
  less
    agg Book.Agg.2
      10000 premium at 0.65 lr
      1000 xs 0
      sev lognorm 100 cv 2
      mixed ig 0.25
  less
    500 fixed expenses and 0.25 premium expenses as "Total Expenses"
  note{Inherit premium from the aggregate, which must carry one. Expenses combined with and, label at the end, do not appear split out in the PnL statement.}
  tags{topic:economics, role:advanced};

xpnl PnLDerive
  derive premium as GWP
  less
    agg Book.Agg.3
      10000 premium as "Technical Premium" at 0.65 lr
      1000 xs 0
      sev lognorm 100 cv 2
      occurrence net of
        750 xs 250 deposit 4000 cede 0.325 as "Occ Re"
      mixed ig 0.25
  less
    2000 fixed expenses as Overhead 0.25 premium expenses as Commission
  note{Derive the premium from the aggregate technical premium by grossing up for expenses.}
  tags{topic:economics, role:advanced};

pnl PnLSignedDsev
  5 premium
  less
    agg PnL.F
      dfreq [3]
      dsev [-1 1]
  note{Signed loss, with PnL in (2, 4, 6, 8), mean 5 and standard deviation sqrt(3).}
  tags{topic:economics, role:intermediate};

pnl PnLSignedAsymmetric
  10 premium
  less
    agg PnL.G
      dfreq [2]
      dsev [-2 1 3] [0.5 0.3 0.2]
  note{A non-symmetric signed dsev, with mean 10 - 2 E[X] = 10.2.}
  tags{topic:economics, role:intermediate};

pnl PnLSignedSsev 100 premium less
  agg PnL.H
    5 claims
    ssev 20 - lognorm 10 cv 0.5
    poisson
  note{Continuous signed severity, with E[loss] = 50 and a margin of 50.}
  tags{topic:economics, role:intermediate};

agg PayoffPrimitive
  dfreq [3]
  dsev [-13 -8 -3 5 8]
  payoff
  note{The payoff orientation suffix marks the variable as an asset-return primitive rather than a loss, so it prices through the dual distortion. loss is the twin suffix, stating the ordinary convention explicitly.}
  tags{topic:economics, role:advanced};

port PnLBook
  note{A two line profit and loss book, cat against property, each line carrying its own premium.}
  tags{topic:portfolio, topic:economics, role:advanced}
  pnl Cat
    2000 premium
    less
      agg PnL.Cat
        2000 premium at 0.55 lr
        sev lognorm 500 cv 3
        poisson
  pnl Prop
    5000 premium
    less
      agg PnL.Prop
        5000 premium at 0.65 lr
        sev lognorm 100 cv 2
        poisson;

agg SignedSeverity
  dfreq [3]
  dsev [-2 5]
  note{Signed severity, so negative outcomes are allowed: three fixed draws give the closed form support -6, 1, 8, 15.}
  tags{topic:aggregate, role:intermediate};

agg SignedStandardDeviation
  dfreq [3]
  dsev [-1 1]
  note{Zero-mean signed severity: the severity standard deviation is 1 and the aggregate standard deviation sqrt(3), derived from the second moment rather than from mean times cv.}
  tags{topic:aggregate, role:intermediate};

agg SignedNormal
  100 claims
  ssev 50 * norm + 10
  poisson
  note{A continuous signed (ssev) profit and loss severity, which is never clamped at zero.}
  tags{topic:aggregate, role:intermediate};

agg SignedLump
  1000000 claims
  dsev [-1 10] [0.9375 0.0625]
  poisson
  note{A near-Gaussian lump at a negative mean of about -312,500, resolved on an automatically chosen window.}
  tags{topic:aggregate, role:advanced};

agg SignedPremiumMinusLoss
  5 claims
  ssev 100 - lognorm 95 cv 0.2
  poisson
  note{Premium minus loss: the constant minus distribution form reflects the severity, giving a mean of 5.}
  tags{topic:aggregate, role:advanced};

agg SignedPremiumMinusLossNormal
  5000 claims
  ssev 100  - lognorm 95 cv 1.2
  poisson
  note{A high frequency premium minus loss payoff carrying both severity and exposure variability, near-Gaussian on a signed window.}
  tags{topic:aggregate, role:advanced}

port SignedGotcha
  note{The sev side of the sev and ssev contrast: a plain sev clamps the normal to a non-negative window, so both units are bounded below where those of SignedPortfolioPair are not.}
  tags{topic:portfolio, topic:economics, role:advanced}
  agg A
    1 claim
    sev 10 * norm + 25
    fixed
  agg B
    1 claim
    sev 10 * norm + 5
    fixed;

port SignedPortfolioPair
  note{The ssev side of the sev and ssev contrast: two signed normal units, offset either way, on one signed window.}
  tags{topic:portfolio, topic:economics, role:advanced}
      agg A
        1 claim
        ssev 10 * norm + 25
        fixed
      agg B
        1 claim
        ssev 10 * norm + 5
        fixed;

port SignedPortfolioMixed
  note{One ordinary loss unit and one signed profit and loss unit in the same portfolio, so the total lives on a signed window.}
  tags{topic:portfolio, topic:economics, role:advanced}
  agg Loss
    30 claims
    sev lognorm 20 cv 0.8
    poisson
  agg PnL
    50 claims
    ssev 10 * norm
    poisson;

# ----------------------------------------------------------------------
# Numerical character
# Moment approximations, window and grid behavior, and the small books the
# pricing surfaces are hand checked against.
# ----------------------------------------------------------------------

agg RawLognorm
  5000 claims
  sev lognorm 100 cv 2
  poisson
  note{The raw distribution, hard to calibrate, with a two regime shape.}
  tags{topic:numerics, role:intermediate};

agg ApproximateSlognorm
  5000 claims
  sev lognorm 100 cv 2
  poisson
  approximate slognorm
  note{The same book under a shifted lognormal moment approximation.}
  tags{topic:numerics, role:intermediate};

agg ApproximateSgamma
  5000 claims
  sev lognorm 100 cv 2
  poisson
  approximate sgamma
  note{The same book under a shifted gamma moment approximation. Compare the tails: matching three moments does not match the tail.}
  tags{topic:numerics, role:intermediate};

agg HeavyTailValidation
  10 claims
  sev 100 * lomax 1.3
  poisson
  note{An infinite variance Pareto: the validator refuses to guess, so bs must be given. The aggregate and severity tails run parallel on a log scale.}
  tags{topic:numerics, role:advanced}
  hints{bs=0.25; log2=16};

agg WindowedSimple
  10_000_000 claims
  dsev [1 2]
  poisson
  note{A concentrated high mean book, resolved on a non-zero output window.}
  tags{topic:numerics, role:advanced};

agg WindowedContinuous
  100000 claims
  sev lognorm 100 cv 0.5
  poisson
  note{A very high claim count, which forces a windowed FFT.}
  tags{topic:numerics, role:advanced};


# ----------------------------------------------------------------------
# Portfolios
# Two units at a time, from the plain pair to the diversification archetypes.
# ----------------------------------------------------------------------

port BasicPortfolio
  note{A plain two unit portfolio.}
  tags{topic:portfolio, role:intro}
  agg A
    50 claims
    1000 xs 0
    sev lognorm 100 cv 1.2
    mixed gamma 0.4
  agg B
    65 claims
    2000 xs 0
    sev lognorm 150 cv 1.6
    mixed gamma 0.2;

port TwoLineBook
  note{A two unit book, thin property against mixed frequency casualty. Capital and price follow downstream.}
  tags{topic:portfolio, role:hero, role:intermediate}
  agg Property
    80 claims
    500 xs 0
    sev lognorm 50 cv 1.2
    poisson
  agg Casualty
    20 claims
    2000 xs 0
    sev lognorm 250 cv 2
    mixed gamma 0.4;

port PropertyCasualty
  note{A portfolio of property and casualty risks, amounts in 000s.}
  tags{topic:portfolio, role:hero, role:intermediate}
  agg Casualty
    5000 premium at 0.9 lr
    5000 xs 0
    sev lognorm 200 cv 8
    mixed gamma 0.45
  agg Property
    4000 premium at 0.85 lr
    10000 xs 0
    sev lognorm 250 cv 12
    mixed gamma 0.15;

port ThinThinPortfolio
      note{Two thin, concentrated units, giving a nearly Gaussian total. Same as PIR tame case study.}
  tags{topic:portfolio, role:intermediate}
  agg A
    1 claim
    sev gamma 50 cv 0.1
    fixed
  agg B
    1 claim
    sev gamma 50 cv 0.15
    fixed;

port ThickThinPortfolio
  note{Thin attritional losses against a bounded but thick cat unit, the rich diversification case.}
  tags{topic:portfolio, role:intermediate}
  agg NonCat
    200 claims
    100 xs 0
    sev gamma 8 cv 0.3
    poisson
  agg Cat
    2 claims
    5000 xs 0
    sev lognorm 500 cv 4
    poisson;

port ThickThickPortfolio
  note{Two unbounded heavy tailed units, with little diversification and a tail driven total.}
  tags{topic:portfolio, role:intermediate}
  agg A
    100 claims
    sev lognorm 50 cv 3
    poisson
  agg B
    100 claims
    sev lognorm 80 cv 3.5
    poisson;

port DiscretePortfolio
  note{Three discrete units with signed severities, so the portfolio total is signed.}
  tags{topic:portfolio, topic:economics, topic:numerics, role:advanced}
  agg A
    dfreq [1 2]
    dsev [-3 -1 2] [0.5 0.3 0.2]
  agg B
    dfreq [1]
    dsev [-2 1 4]
  agg C
    dfreq [2]
    dsev [1 3];
# ----------------------------------------------------------------------
# Book and paper reproductions
# ----------------------------------------------------------------------

port BodoffOne
  note{Bodoff thought experiment number 1, the wind and quake pair whose allocation the paper works through.}
  tags{topic:portfolio, role:intermediate, role:published}
  agg Wind.1
    dfreq [1]
    dsev [0 99] [0.8 0.2]
  agg Quake.1
    dfreq [1]
    dsev [0 100] [0.95 0.05]

port BodoffTwo
  note{Bodoff thought experiment number 2, the same pair with the wind loss cut to 50.}
  tags{topic:portfolio, role:intermediate, role:published}
  agg Wind.2
    dfreq [1]
    dsev [0 50] [0.8 0.2]
  agg Quake.2
    dfreq [1]
    dsev [0 100] [0.95 0.05]

port BodoffThree
  note{Bodoff thought experiment number 3, the same pair with the wind loss cut again, to 5.}
  tags{topic:portfolio, role:intermediate, role:published}
  agg Wind.3
    dfreq [1]
    dsev [0 5] [0.8 0.2]
  agg Quake.3
    dfreq [1]
    dsev [0 100] [0.95 0.05]

port BodoffFour
  note{Bodoff thought experiment number 4, whose exponential severity needs sharpen to price.}
  tags{topic:portfolio, topic:numerics, role:advanced, role:published}
  agg a
    0.25 claims
    sev 4 * expon
    poisson
  agg b
    0.05 claims
    sev 20 * expon
    poisson
  agg c
    0.05 claims
    sev 100 * expon
    poisson;

port PIRTame
  note{The Tame case study from Pricing Insurance Risk. For the reinsurance variant see the text.}
  tags{topic:portfolio, role:intermediate, role:published}
  hints{bs=1/64; log2=16; padding=1}
  agg Tame.A
    1 claim
    sev gamma 50 cv 0.1
    fixed
  agg Tame.B
    1 claim
    sev gamma 50 cv 0.15
    fixed;

port PIRCatNonCatGross
  note{The gross Cat and Non-Cat case study from Pricing Insurance Risk.}
  tags{topic:portfolio, role:intermediate, role:published}
  hints{bs=1/64; log2=16; padding=1}
  agg CNC.NonCat
    1 claim
    sev gamma 80 cv 0.15
    fixed
  agg CNC.Cat
    1 claim
    sev lognorm 20 cv 1
    fixed;

port PIRCatNonCatNet
  note{The net Cat and Non-Cat case study from Pricing Insurance Risk.}
  tags{topic:portfolio, role:intermediate, role:published}
  hints{bs=1/64; log2=16; padding=1}
  agg CNC.Net.NonCat
    1 claim
    sev gamma 80 cv 0.15
    fixed
  agg CNC.Net.Cat
    1 claim
    sev lognorm 20 cv 1
    fixed
    aggregate net of
      79.64 xs 41.11;

port PIRDiscrete
  note{The Discrete case study from Pricing Insurance Risk.}
  tags{topic:portfolio, role:intermediate, role:published}
  hints{bs=1; log2=8; padding=1}
  agg Discrete.X1
    1 claim
    dsev [0 8 10] [0.5 0.25 0.25]
    fixed
  agg Discrete.X2
    1 claim
    dsev [0 1 90] [0.5 0.25 0.25]
    fixed;

agg DefectivePareto
  1 claim
  sev 1000 * lomax 1.5
  fixed
  note{A defective aggregate: the Lomax severity has no finite second moment, so no bucket size can be estimated and the build refuses.}
  tags{topic:numerics, role:advanced}
  hints{normalize=False};

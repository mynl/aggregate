    note{Gross / ceded / net joint view of a reinsured book.}
    tags{topic:bivariate, topic:reinsurance};

# ----------------------------------------------------------------------
# Profit and loss (signed support)
# USHurr refers to agg.USXOLTower, declared in the reinsurance section.
# ----------------------------------------------------------------------

xpnl USHurr as "US Hurricane"
  20 premium as "Gross Premium"
  less agg.USXOLTower
  tags{role:hero, topic:reinsurance}
  note{ILW model of US Cat. Amounts in billions.}
  hints{bs=2;log2=16;normalize=False;};

pnl PnLSimple
  1000 premium
  less
    agg E.PNL_e
      1000 premium at 0.9 lr
      1000 xs 0
      sev lognorm 120 cv 1
      mixed gamma 0.25
  note{Single profit-and-loss line.}
  tags{topic:pnl};

pnl PnLClaims
  100 premium
  less
    agg PnLprem.Claims_e
      10 claims
      sev lognorm 8 cv 1.5
      poisson
  note{claims form: premium independent of the loss model}
  tags{topic:pnl};

pnl PnLLoss
  100 premium
  less
    agg PnLprem.Loss_e
      85 loss
      sev lognorm 8 cv 1.5
      poisson
  note{expected-loss form: E[loss]=85, margin 15}
  tags{topic:pnl};

pnl PnLLossRatio
  1000 premium
  less
    agg PnLprem.LR_e
      1000 premium at 0.7 lr
      sev lognorm 100 cv 2
      poisson
  note{loss ratio form: E[loss]=700, margin 300}
  tags{topic:pnl};

pnl PnLVector
  [100 200 100] premium
  less
    agg PnLprem.Vec_e
      [100 200 100] premium at 0.8 lr
      [1000 2000 5000] xs 0
      sev lognorm 500 cv 2
      poisson
  note{Vector premium: shift 400, mean 80 = sum premium_i (1 - lr).}
  tags{topic:pnl};

pnl PnLSignedDsev
  5 premium
  less
    agg PnLsigned.Dsev_e
      dfreq [3]
      dsev [-1 1]
  note{signed loss: PnL in (2,4,6,8), mean 5, sd sqrt3}
  tags{topic:pnl};

pnl PnLSignedAsymmetric
  10 premium
  less
    agg PnLsigned.Asym_e
      dfreq [2]
      dsev [-2 1 3] [0.5 0.3 0.2]
  note{non-symmetric signed dsev: mean = 10 - 2 E[X] = 10.2}
  tags{topic:pnl};

pnl PnLSignedSsev 100 premium less
  agg PnLsigned.Ssev_e
    5 claims
    ssev 20 - lognorm 10 cv 0.5
    poisson
  note{continuous signed severity: E[loss]=50, margin 50}
  tags{topic:pnl};

port PnLBook
  tags{topic:portfolio, topic:pnl}
  pnl Cat
    2000 premium
    less
      agg Cat_e
        2000 premium at 0.55 lr
        sev lognorm 500 cv 3
        poisson
  pnl Prop
    5000 premium
    less
      agg Prop_e
        5000 premium at 0.65 lr
        sev lognorm 100 cv 2
        poisson;

agg SignedSeverity
  dfreq [3]
  dsev [-2 5]
  note{Signed severity, negative outcomes allowed; three fixed draws give the closed-form support -6, 1, 8, 15.}
  tags{topic:severity, topic:pnl};

agg SignedStandardDeviation
  dfreq [3]
  dsev [-1 1]
  note{zero-mean signed; sev SD 1, agg SD sqrt(3) -- derived from ex2, not mean*cv}
  tags{topic:pnl};

agg SignedSymmetric
  20 claims
  dsev [-1 1]
  poisson
  note{symmetric P&L; mean 0}
  tags{topic:pnl};

agg SignedNormal
  100 claims
  ssev 50 * norm + 10
  poisson
  note{continuous signed (ssev) P&L severity; never clamps}
  tags{topic:pnl};

agg SignedLump
  1000000 claims
  dsev [-1 10] [0.9375 0.0625]
  poisson
  note{near-Gaussian lump at a negative mean ~ -312500; auto window}
  tags{topic:pnl};

agg SignedPremiumMinusLoss
  5 claims
  ssev 100 - lognorm 80 cv .2
  poisson
  note{premium minus loss: constant - dist reflects the severity (sev mean 20)}
  tags{topic:pnl};

port SignedGotcha
  note{The sev side of the sev / ssev contrast: a spliced sev clamps the normal to a non-negative window, so the two units are bounded below where SignedPortfolioPair is not.}
  tags{topic:portfolio, topic:pnl}
  agg A
    50 claims
    sev 10 * norm + 5 splice [0] [40]
    poisson
  agg B
    50 claims
    sev 10 * norm + -5 splice [0] [35]
    poisson;

port SignedPortfolioPair
  note{The ssev side of the sev / ssev contrast: two signed normal units, offset either way, on one signed window.}
  tags{topic:portfolio, topic:pnl}
  agg A
    50 claims
    ssev 10 * norm + 5
    poisson
  agg B
    50 claims
    ssev 10 * norm + -5
    poisson;

port SignedPortfolioMixed
  tags{topic:portfolio, topic:pnl}
  agg Loss
    30 claims
    sev lognorm 20 cv 0.8
    poisson
  agg PnL
    50 claims
    ssev 10 * norm
    poisson;

# ----------------------------------------------------------------------
# Numerical character
# Moment approximations, window and grid behavior, and the small books the
# pricing surfaces are hand checked against.
# ----------------------------------------------------------------------

agg ApproximateGamma
  5000 claims
  sev lognorm 100 cv 2
  poisson
  approximate sgamma
  note{Shifted-gamma moment approximation.}
  tags{topic:numerics};

agg ApproximateRightSlognorm
  5000 claims
  sev lognorm 100 cv 2
  poisson
  approximate slognorm
  tags{topic:numerics};

agg ApproximateLeftReflect
  1 claim
  sev 100 * beta 5 1.3
  fixed
  approximate sgamma
  tags{topic:numerics};

agg ApproximateAggReins
  100 claims
  sev lognorm 100 cv 2
  poisson
  aggregate net of
    100 xs 0
  approximate sgamma
  tags{topic:numerics};

pnl ApproximatePnL
  600000 premium
  less
    agg APX.PnL_e
      5000 claims
      sev lognorm 100 cv 2
      poisson
      approximate sgamma
  tags{topic:pnl, topic:numerics};

agg HeavyTailValidation
  10 claims
  sev 100 * pareto 1.3 + -100
  poisson
  note{Infinite-variance Pareto -- the validator refuses to guess.}
  tags{topic:numerics}
  hints{bs=0.25; log2=16};

agg WindowContinuous
  100000 claims
  sev lognorm 100 cv 0.5
  poisson
  tags{topic:numerics};

agg WindowedGrid
  10000000 claims
  dsev [1 2]
  poisson
  note{Concentrated high-mean book -- resolved on a non-zero output window.}
  tags{topic:numerics};

agg WindowedSimple
  10000 claims
  dsev [-1 1]
  poisson
  note{Windowed / discrete severity at high frequency.}
  tags{topic:numerics};

port NumericsOneDice
  note{one-line port: line == total}
  tags{topic:portfolio, topic:numerics}
  agg D
    dfreq [1 2 3 4 5 6]
    dsev [1 2 3 4 5 6];

port NumericsPayPair
  note{homogeneous payoff book prices through the dual}
  tags{topic:portfolio, topic:numerics}
  pnl P1
    10 premium
    less
      agg P1_e
        dfreq [1]
        dsev [2 5]
  pnl P2
    8 premium
    less
      agg P2_e
        dfreq [1]
        dsev [1 3];

port NumericsSignedDiscrete
  note{signed totals price via dot(kappa, gp); shares NaN}
  tags{topic:portfolio, topic:pnl, topic:numerics}
  agg A
    dfreq [1 2]
    dsev [-3 -1 2] [0.5 0.3 0.2]
  agg B
    dfreq [1]
    dsev [-2 1 4]
  agg C
    dfreq [2]
    dsev [1 3];

port NumericsUnbounded
  note{mass-on-unbounded refused in the lifted builder}
  tags{topic:portfolio, topic:numerics}
  agg U
    5 claims
    sev lognorm 10 cv 1
    poisson;

# ----------------------------------------------------------------------
# Portfolios
# Two units at a time, from the plain pair to the diversification archetypes.
# ----------------------------------------------------------------------

port BasicPortfolio
  note{Two-unit portfolio.}
  tags{topic:portfolio}
  agg A
    50 claims
    1000 xs 0
    sev lognorm 100 cv 1.2
    mixed gamma 0.4
  agg B
    65 claims
    2000 xs 0
    sev lognorm 150 cv 1.6
    mixed gamma 0.2;

port TwoLineBook
  note{Two-unit book: thin property + mixed-frequency casualty. Capital and price downstream.}
  tags{role:hero, topic:portfolio}
  agg Property
    80 claims
    500 xs 0
    sev lognorm 50 cv 1.2
    poisson
  agg Casualty
    20 claims
    2000 xs 0
    sev lognorm 250 cv 2
    mixed gamma 0.4;

port PropertyCasualty
  note{Portfolio of property and casualty risks, amounts in 000s.}
  tags{role:hero, topic:portfolio}
  agg Casualty
    5000 premium at 0.9 lr
    5000 xs 0
    sev lognorm 200 cv 8
    mixed gamma 0.45
  agg Property
    4000 premium at 0.85 lr
    10000 xs 0
    sev lognorm 250 cv 12
    mixed gamma 0.15;

port SharedMixPortfolio
  note{Shared frequency mixer = common shock; correlated units on one grid.}
  tags{topic:portfolio}
  agg A
    100 claims
    sev lognorm 50 cv 1.5
    mixed gamma 0.4
  agg B
    120 claims
    sev lognorm 60 cv 1.5
    mixed gamma 0.4;

port ThinThinPortfolio
  note{Two thin, concentrated units -- nearly Gaussian total.}
  tags{topic:portfolio}
  agg A
    1 claim
    sev gamma 50 cv 0.1
    fixed
  agg B
    1 claim
    sev gamma 50 cv 0.15
    fixed;

port ThickThinPortfolio
  note{Thin attritional + bounded-but-thick cat -- the rich diversification case.}
  tags{topic:portfolio}
  agg NonCat
    200 claims
    100 xs 0
    sev gamma 8 cv 0.3
    poisson
  agg Cat
    2 claims
    5000 xs 0
    sev lognorm 500 cv 4
    poisson;

port ThickThickPortfolio
  note{Two unbounded heavy-tailed units -- little diversification, tail-driven.}
  tags{topic:portfolio}
  agg A
    100 claims
    sev lognorm 50 cv 3
    poisson
  agg B
    100 claims
    sev lognorm 80 cv 3.5
    poisson;

# ----------------------------------------------------------------------
# Book and paper reproductions
# ----------------------------------------------------------------------

port BodoffOne
  note{Bodoff Thought Experiment No. 1}
  tags{topic:portfolio, role:paper}
  agg wind1
    1 claim
    sev dhistogram xps [0 99] [0.8 0.2]
    fixed
  agg quake1
    1 claim
    sev dhistogram xps [0 100] [0.95 0.05]
    fixed;

port BodoffOneNet
  note{Bodoff Thought Experiment No. 1}
  tags{topic:portfolio, role:paper}
  agg wind1
    1 claim
    dsev [0 99] [0.8 0.2]
    fixed
  agg quake1
    1 claim
    dsev [0 100] [0.95 0.05]
    fixed;

port BodoffTwo
  note{Bodoff Thought Experiment No. 2}
  tags{topic:portfolio, role:paper}
  agg wind2
    1 claim
    sev dhistogram xps [0 50] [0.8 0.2]
    fixed
  agg quake2
    1 claim
    sev dhistogram xps [0 100] [0.95 0.05]
    fixed;

port BodoffTwoNet
  note{Bodoff Thought Experiment No. 2}
  tags{topic:portfolio, role:paper}
  agg wind2
    1 claim
    dsev [0 50] [0.8 0.2]
    fixed
  agg quake2
    1 claim
    dsev [0 100] [0.95 0.05]
    fixed;

port BodoffThree
  note{Bodoff Thought Experiment No. 3}
  tags{topic:portfolio, role:paper}
  agg wind3
    1 claim
    sev dhistogram xps [0 5] [0.8 0.2]
    fixed
  agg quake3
    1 claim
    sev dhistogram xps [0 100] [0.95 0.05]
    fixed;

port BodoffThreeNet
  note{Bodoff Thought Experiment No. 3}
  tags{topic:portfolio, role:paper}
  agg wind3
    1 claim
    dsev [0 5] [0.8 0.2]
    fixed
  agg quake3
    1 claim
    dsev [0 100] [0.95 0.05]
    fixed;

port BodoffFour
  note{Bodoff Thought Experiment No. 4; exponential severity requires sharpen}
  tags{topic:portfolio, role:paper, topic:numerics}
  agg a
    0.25 claims
    sev 4 * expon
    poisson
  agg b
    0.05 claims
    sev 20 * expon
    poisson
  agg c
    0.05 claims
    sev 100 * expon
    poisson;

port BodoffWindQuake
  note{Bodoff thought-experiment -- discrete two-peril allocation.}
  tags{role:hero, topic:portfolio, role:paper}
  agg Wind
    1 claim
    dsev [0 99] [0.8 0.2]
    fixed
  agg Quake
    1 claim
    dsev [0 100] [0.95 0.05]
    fixed;

port NumericsBodoff
  note{bounded discrete; linear vs lifted; mass distortion exact}
  tags{topic:portfolio, role:paper, topic:numerics}
  agg wind
    1 claim
    sev dhistogram xps [0 99] [0.8 0.2]
    fixed
  agg quake
    1 claim
    sev dhistogram xps [0 100] [0.95 0.05]
    fixed;

port PIRTame
  note{PIR Tame case study. For reinsurance see text.}
  tags{topic:portfolio, role:paper}
  hints{bs=1/64; log2=16; padding=1}
  agg Tame.A
    1 claim
    sev gamma 50 cv 0.1
    fixed
  agg Tame.B
    1 claim
    sev gamma 50 cv 0.15
    fixed;

port PIRCatNonCatGross
  note{PIR Cat-Noncat gross case study.}
  tags{topic:portfolio, role:paper}
  hints{bs=1/64; log2=16; padding=1}
  agg CNC.NonCat
    1 claim
    sev gamma 80 cv 0.15
    fixed
  agg CNC.Cat
    1 claim
    sev lognorm 20 cv 1
    fixed;

port PIRCatNonCatNet
  note{PIR Cat-Noncat net case study.}
  tags{topic:portfolio, role:paper}
  hints{bs=1/64; log2=16; padding=1}
  agg CNC.Net.NonCat
    1 claim
    sev gamma 80 cv 0.15
    fixed
  agg CNC.Net.Cat
    1 claim
    sev lognorm 20 cv 1
    fixed
    aggregate net of
      79.64 xs 41.11;

port PIRDiscrete
  note{PIR Discrete case study.}
  tags{topic:portfolio, role:paper}
  hints{bs=1; log2=8; padding=1}
  agg Discrete.X1
    1 claim
    dsev [0 8 10] [0.5 0.25 0.25]
    fixed
  agg Discrete.X2
    1 claim
    dsev [0 1 90] [0.5 0.25 0.25]
    fixed;

agg DefectivePareto
  1 claim
  sev 1000 * pareto 1.5 + -1000
  fixed
  note{defective; no finite 2nd moment}
  tags{role:paper}
  hints{normalize=False};


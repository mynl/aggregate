# ======================================================================
# library.agg  --  the shipped DecL library
# ======================================================================
#
# Version: 1
#
# PURPOSE
# -------
# ONE library. It replaces examples.agg (the old curated set),
# cookbook.agg (the feature walkthrough) and actuarial-severity-curves.agg
# (the severity reference), which were three files with overlapping
# purpose, three different naming conventions, and no machine-readable
# grouping. It is the default `build` recipe base and the source the
# aggregate_api (aLL) SPA reads for its Examples dropdown.
#
# NAMES are descriptive and GLOBALLY UNIQUE across kinds, so `build('X')`
# and `build.recipe('X')` always mean the same entry and no `kind=`
# disambiguator is ever needed. The old single-letter filing prefixes
# (A., B., K. ...) are gone, grouping is what tags{} is for. Names that
# lead with a citekey (Mack2003.Lognorm) keep it: that is a citation, not
# a filing code.
#
# THE TRAILER carries everything a tool reads. Comments are for humans
# only, nothing in src/aggregate parses them (the lexer deletes them
# before the grammar ever sees a line).
#
#   note{...}       one-line description. The SPA dropdown blurb.
#   tags{...}       comma- and/or space-separated slugs; grouping and
#                   selection (build.discover(tags=...)).
#   hints{...}      key=value; build settings, caller-wins.
#
# A trailer holds FACTS ABOUT THE ENTRY, and nothing longer. Long-form
# write-ups are not facts about an entry, they are documents, and they live
# in the presentations repository (C:/s/AI/notes/aggregate-presentations),
# which is the staging ground for material that ends up in the monograph.
# The `doc{{{...}}}` clause that used to carry them here was retired before
# 1.0: it mixed a book into a declaration language, and the DecL stable-tier
# promise would have frozen that mistake for the life of the major version.
# See dev/done/plan-decommission-docs.md.
#
# A note that wants a library program should PRINT it rather than retype it:
#
#     print(build.recipe('LayerPicks').decl)
#
# which reads the live library and so cannot go stale.
#
# TAG VOCABULARY: namespaced, and it never restates the object's TYPE.
#
# Type is what `kind` is for: build.discover(kind='sev') finds every severity
# object. A tag saying `severity` on a `sev` entry would be dead weight, and
# would invite "why does type appear twice, which do I use?". So every tag
# carries a namespace and answers a question `kind` cannot:
#
#   topic:X   what the recipe is ABOUT, severity frequency aggregate
#             reinsurance pnl portfolio distortion bivariate bounds ruin
#             picks numerics. Independent of type: an `agg` entry demonstrating a
#             severity form is topic:severity, and that is not a restatement.
#   role:X    where it stands, hero (landing page) intro (teaching order)
#             reference (a lookup table entry) paper (reproduces a published
#             result).
#   check:X   which invariant the entry is worth checking against. Six
#             archetypes, and the slug is the label without the [Check-]:
#
#               reconciliation      things add up: net + ceded = gross;
#                                   walks foot down the sheet; allocations
#                                   sum to the total.
#               scaling-sweep       vary one knob, watch the output move as
#                                   predicted (sweep a share 25/50/75/100%
#                                   and see ceded premium trace a line).
#               independent-oracle  est_* (FFT) against theoretic moments, a
#                                   closed form, or a hand convolution.
#               limiting-case       sanity bounds: TVaR >= VaR; premium >=
#                                   expected loss; a distortion has g(0)=0,
#                                   g(1)=1 and is concave; zero placement
#                                   gives back gross.
#               round-trip          format_program(build(x)) round-trips;
#                                   two equivalent spellings agree.
#               cross-object        an aggregate priced alone equals its
#                                   allocation in a one-unit portfolio;
#                                   bivariate marginals recover the
#                                   univariates.
#
#             tests/test_library_entries.py is where the checks live.
#   slow      the ONE bare tag, deliberately: it names a pytest marker, not a
#             property of the subject.
#
# Enforced by tests/test_agg_libraries.py, a bare, un-namespaced tag fails.
#
#   build.discover(kind='sev')                        # by type
#   build.discover(tags='topic:severity')             # by subject
#   build.discover(kind='agg', tags='topic:severity') # both
#
# PLACEMENT: on a `port`, the trailer goes on the `port` header line,
# a trailer written after the last unit binds to that unit, because the
# portfolio's trailer slot closes before the units are read.
#
# HOW MUCH DOCUMENTATION: every entry carries a note{...}, and that is the
# whole norm. It is all `discover` and the object dropdown need, and there
# is no second tier to fill in: `build.recipes` is a DIRECTORY of the
# library, never a backlog.
#
# LAYOUT: the canonical `spread` form, one clause per line at a two-space
# indent, each statement closed by `;` and separated by a blank line. It is
# what `build.recipe('X').decl` prints and what every generated cookbook page
# shows, so the file and the docs read alike. Regenerate it with
# `python dev/done/reflow_library.py`, which renders each entry through
# `decl_writer.format_program(..., layout='spread')` and refuses to write
# unless every statement still parses to the same spec.
#
# Thirteen entries are exempt, and stay hand-written. The unparser cannot
# invert a named object reference (`sev.UnitSeverity` is resolved and inlined at
# parse time, and since a216 an engine reference like `less agg.USXOLTower`
# writes its whole body out), or the `minimum` distortion combinator (the child
# names are not retained). Three more keep the compact `ssev <c> - <dist>`
# spelling, whose canonical form `-1 * <dist> + <c>` parses two ways. All are
# laid out in the same style by hand; tests/test_agg_libraries.py holds the
# list and checks the rest.
#
# A `sev agg.NAME` reference is NOT in that set: since a293 the writer renders
# it, because the spec records the reference instead of inlining the object.
#
# SECTION ORDER runs starter examples, distortions, severity, frequency,
# aggregates, aggregates with reinsurance, an aggregate as a severity,
# bivariate, profit and loss, numerics, portfolios, papers.
#
# DecL is whitespace-insensitive, so a statement may be laid out however reads
# best. Only two things separate statements: a blank line, or a `;` at the end
# of a line. A comment never does.
# ======================================================================

# ----------------------------------------------------------------------
# Starter examples
# Dice, coins and the plain compound distributions. Everything here is
# exact or nearly so, which is what makes it the place to start.
# ----------------------------------------------------------------------

agg DiceOneDie
  dfreq [1 2 3 4 5 6]
  dsev [1]
  note{The roll of a single die.}
  tags{topic:aggregate};

agg DiceOneDie.Sev
  dfreq [1]
  dsev [1 2 3 4 5 6]
  note{The roll of a single dice as severity.}
  tags{topic:aggregate, role:intro};

agg DiceTwoDice
  dfreq [2]
  dsev [1 2 3 4 5 6]
  note{Sum of the rolls of two dice.}
  tags{topic:aggregate};

agg ThreeDice
  dfreq [3]
  dsev [1 2 3 4 5 6]
  note{Sum of three dice, exact discrete aggregate; zero validation error.}
  tags{topic:aggregate, role:intro, check:independent-oracle};

agg DiceOfDice
  dfreq [1 2 3 4 5 6]
  dsev [1 2 3 4 5 6]
  note{Roll a die for the claim count, then sum that many die rolls. Check by hand! See https://blog.mynl.com/posts/notes/2026-08-11-dice-of-dice/index.html. }
  tags{topic:aggregate, topic:numerics};

agg BasicRandomWalk
  dfreq [12]
  dsev [-1 1]
  note{Twelve step random walk.}
  tags{topic:aggregate};

agg BasicBiasedCoints
  dfreq [1000]
  dsev [0 1] [.51 .49]
  note{Toss of one thousand slightly biased coins.}
  tags{topic:aggregate};

agg BasicDfreq
  dfreq [1 2 3]
  dsev [1 2 10]
  note{1, 2 or 3 claims, all equally likely; severity 1, 2 or 10, all equally likely.}
  tags{topic:aggregate};

agg BasicDfreqWeighted
  dfreq [1 2 3] [0.5 0.25 0.25]
  dsev [1 2 10] [0.4 0.4 0.2]
  note{1, 2 or 3 claims; severity 1, 2 or 10; both clauses carry explicit probabilities.}
  tags{topic:frequency};

agg DiscreteBook
  dfreq [1 2 3 4 5 6 7 20]
  dsev [-10 -5 -2 -1 0 1 2 3] [0.0625 0.0625 0.125 0.125 0.125 0.25 0.125 0.125]
  note{Discrete example with signed severity; empirical distributions can be used directly!}
  tags{topic:aggregate};

agg BasicBook
  250 claims
  1000 xs 0
  sev lognorm 100 cv 1.5
  poisson
  note{Basic realistic insurance book with Poisson frequency, lognormal severity and an occurrence limit. The workhorse compound distribution.}
  tags{topic:aggregate, role:intro};

# ----------------------------------------------------------------------
# Distortions (risk measures)
# PHDistortion and DualDistortion come first: MinimumDistortion refers to
# them by name, and builtin references resolve by sequential load.
# Chosen to have equal gini_p coefficients equal to 0.2 using
#    from aggregate.spectral import consistent_distortions
#    d = consistent_distortions(0.2)   # dict keyed ccoc, ph, wang, dual, tvar
# ----------------------------------------------------------------------

distortion CCoCDistortion ccoc 0.25
  note{Constant cost of capital distortion, pricing to 25% return on capital and 20% = .25 / 1.25 discount rate.}
  tags{topic:distortion};

distortion PHDistortion ph 2/3
  note{Proportional-hazard distortion.}
  tags{topic:distortion, role:intro, check:limiting-case};

distortion WangDistortion wang 0.3582869092425833
  note{Wang transform, g(s) = Phi(Phi inverse (s) + lambda), lambda = 0.358....}
  tags{topic:distortion};

distortion DualDistortion dual 1.5
  note{Dual-power distortion; the second leaf for the minimum below.}
  tags{topic:distortion};

distortion TVaRDistortion tvar 0.2
  note{TVaR 0.2 distortion: prices as the average of the worst 60% of outcomes. }
  tags{topic:distortion};

distortion MinimumDistortion minimum dist.PHDistortion dist.DualDistortion
  note{A minimum of two distortions is a distortion.}
  tags{topic:distortion};

# ----------------------------------------------------------------------
# Severity: the clause forms
# Each severity can be referenced by name using sev.name.
# ----------------------------------------------------------------------

sev UnitSeverity dsev [1]
  tags{topic:severity};

sev MixedExponentialSev [10 50 200] * expon wts [0.6 0.3 0.1]
  note{Mixed exponential as used by ISO/Verisk. Cannot be build as a Sev object, fold it into an agg with dfreq[1] to build.}
  tags{topic:severity};

sev CommAutoMixedExponentialSev [2764 24548 275654 1917469 10000000] * expon wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  note{Mixed exponential commercial auto severity-like, five exponential components based on the 2008 cost level, untrended; mean 13,990. Parameters from Mildenhall, aggregate: Frequency-Severity Distributions Made Easy, Actuarial Review 50(3), pages 31 to 34, 2023, https://ar.casact.org/aggregate-frequency-severity-distributions-made-easy/.}
  tags{topic:severity, role:reference, role:paper};

sev ParetoSev 1000 * pareto 1.8 + -1000
  note{Single-parameter Pareto large-loss curve (scale 1000, shape 1.8), shifted to ground-up.}
  tags{topic:severity};

sev ParetoSev2 1000 * lomax 1.8
  note{Lomax is the usual Pareto large-loss curve (scale 1000, shape 1.8).}
  tags{topic:severity};

agg SevZeroParameter
  1 claim
  sev 100 * expon
  fixed
  note{Scaled exponential, no shape parameters.}
  tags{topic:severity};

agg SevOneParameter
  1 claim
  sev 10 * gamma 0.3
  fixed
  note{scaled gamma with shape}
  tags{topic:severity};

agg SevOneParameterScaled
  1 claim
  sev gamma 12 cv 0.3
  fixed
  note{gamma by mean and cv}
  tags{topic:severity};

agg SevTwoParameter
  1 claim
  sev 50 * beta 3 2 + 10
  fixed
  note{50*beta(3,2) + 10}
  tags{topic:severity};

agg SevLognormCV
  1 claim
  sev lognorm 50 cv 0.3
  fixed
  note{lognormal by mean and cv}
  tags{topic:severity};

agg SevReversed
  1 claim
  ssev -(exp(-.3**2/2) * 50) * lognorm 0.3
  fixed
  note{Signed severity, mean equals 50 and cv is (exp(.3**2) - 1)**.5 which is slightly greater than 0.3.}
  tags{topic:severity};

agg SevScaledShifted
  1 claim
  sev 100 * expon + 10
  fixed
  note{scaled and shifted exponential}
  tags{topic:severity};

agg SevMixture
  8 claims
  sev 100 * [lognorm expon] [0.5 1] wts [0.6 0.4]
  mixed gamma 0.3
  note{mixture of severities: all aspects of the severity distribution can be mixed.}
  tags{topic:severity};

agg SevSpliced
  1 claim
  sev lognorm 10 cv 1.5 splice [5 25]
  fixed
  note{lognormal conditional on 5 <= X <= 25}
  tags{topic:severity};

agg SevLayer
  1 claim
  20 xs 5
  sev lognorm 10 cv 0.5
  fixed
  note{conditional severity, the layer conditions on the loss exceeding the 5 attachment, the default reading}
  tags{topic:severity};

agg SevLayer.Unconditional
  1 claim
  20 xs 5
  sev lognorm 10 cv 0.5 !
  fixed
  note{Unconditional severity: the trailing ! keeps losses below the 5 attachment in the count as zeros, so the layer mean is lower than the conditional reading.}
  tags{topic:severity};

agg MixedSeverityProfile
  [1000 2000 500] premium at [0.8 0.7 0.5] lr
  sev lognorm 10 cv [0.35 0.5] wts [0.625 0.375]
  mixed gamma 0.5
  note{Mixed exposure, severity, and frequency, shared mixing shows up in stats_df (More->Stats in aLL). Output has six components.}
  tags{topic:severity};

# ----------------------------------------------------------------------
# Severity curve reference
# The named families first, in alphabetical order for lookup, then the
# published parameterizations under their citekeys.
# ----------------------------------------------------------------------

agg CurveBeta
  1 claim
  sev 100000 * beta 2 5
  fixed
  note{Beta on [0, 100000], bounded severity / destruction rate, shapes a=2, b=5.}
  tags{topic:severity, role:reference};

agg CurveBetaPrime
  1 claim
  sev 10000 * betaprime 3 4
  fixed
  note{Beta-prime / beta-of-the-2nd-kind (B2), the GB2 representative. Cummins et al. (1990).}
  tags{topic:severity, role:reference};

agg CurveBurr12
  1 claim
  sev 10000 * burr12 3 1.2
  fixed
  note{Burr XII / Singh-Maddala (GB2, p=1), shapes c=3, d=1.2.}
  tags{topic:severity, role:reference};

agg CurveBurrIII
  1 claim
  sev 10000 * burr 3 1.2
  fixed
  note{Burr III / Dagum (GB2, q=1), shapes c=3, d=1.2.}
  tags{topic:severity, role:reference};

agg CurveExponential
  1 claim
  sev 10000 * expon
  fixed
  note{Exponential: constant hazard, cv = 1. scipy expon; scale = mean.}
  tags{topic:severity, role:reference};

agg CurveFrechet
  1 claim
  sev 10000 * invweibull 3
  fixed
  note{Frechet / inverse Weibull (type II extreme value), shape c = 3.}
  tags{topic:severity, role:reference};

agg CurveGEV
  1 claim
  sev 10000 * genextreme -0.2 + 20000
  fixed
  note{Generalized extreme value (GEV), shape -0.2 (Frechet domain).}
  tags{topic:severity, role:reference};

agg CurveGPD
  1 claim
  sev 10000 * genpareto 0.3
  fixed
  note{Generalized Pareto (GPD), xi = 0.3, the peaks-over-threshold tail (EVT).}
  tags{topic:severity, role:reference};

agg CurveGamma
  1 claim
  sev gamma 10000 cv 0.8
  fixed
  note{Gamma severity by mean and cv (shape = 1/cv^2). Klugman et al.; Parodi.}
  tags{topic:severity, role:reference};

agg CurveGenGamma
  1 claim
  sev 10000 * gengamma 2 1.5
  fixed
  note{Generalized (transformed) gamma, shapes a=2, c=1.5, nests gamma/Weibull/lognormal.}
  tags{topic:severity, role:reference};

agg CurveGumbel
  1 claim
  sev 5000 * gumbel_r + 20000
  fixed
  note{Gumbel (type I extreme value), block maxima, light tail.}
  tags{topic:severity, role:reference};

agg CurveInverseGamma
  1 claim
  sev 10000 * invgamma 4.07
  fixed
  note{Inverse gamma, shape a = 4.07, heavy right tail (Klugman et al.).}
  tags{topic:severity, role:reference};

agg CurveInverseGaussian
  1 claim
  sev invgauss 10000 cv 0.7
  fixed
  note{Inverse Gaussian by mean and cv, right-skewed, Tweedie-adjacent.}
  tags{topic:severity, role:reference};

agg CurveLogLogistic
  1 claim
  sev 10000 * fisk 2.5
  fixed
  note{Log-logistic / Fisk (GB2, p=q=1), shape c=2.5.}
  tags{topic:severity, role:reference};

agg CurveLognormal
  1 claim
  sev lognorm 10000 cv 1.5
  fixed
  note{Lognormal by mean and cv, the default working severity.}
  tags{topic:severity, role:reference};

agg CurveLomax
  1 claim
  sev 10000 * lomax 2.5
  fixed
  note{Lomax / Pareto Type II (shifted Pareto), alpha = 2.5.}
  tags{topic:severity, role:reference};

agg CurvePareto
  1 claim
  sev 10000 * pareto 2.5 + -10000
  fixed
  note{Pareto Type I (European), alpha = 2.5, shifted ground-up.}
  tags{topic:severity, role:reference};

agg CurveWeibull
  1 claim
  sev 10000 * weibull_min 1.5
  fixed
  note{Weibull (weibull_min), shape c = 1.5: increasing hazard.}
  tags{topic:severity, role:reference};

sev Berens1997.Lognorm lognorm 150000 cv 0.25
  note{Berens1997}
  tags{topic:severity, role:reference, role:paper};

sev Berens1997.Pareto 50000 * pareto 1.5
  note{Berens1997}
  tags{topic:severity, role:reference, role:paper};

sev Bodoff2017.Pareto 50000 * lomax 1.5
  note{Bodoff2017}
  tags{topic:severity, role:reference, role:paper};

sev Jin2016.Gamma gamma 6 cv 0.5774
  note{Jin2016}
  tags{topic:severity, role:reference, role:paper};

sev Jin2016.Pareto 100 * lomax 20
  note{Jin2016}
  tags{topic:severity, role:reference, role:paper};

sev Kang2019.Pareto 3.5 * lomax 3.5
  note{Kang2019}
  tags{topic:severity, role:reference, role:paper};

sev Mack2003.AmericanPareto 10000 * lomax 1.5
  note{Mack2003}
  tags{topic:severity, role:reference, role:paper};

sev Mack2003.Lognorm lognorm 10000 cv 4.953
  note{Mack2003}
  tags{topic:severity, role:reference, role:paper};

sev Mack2003.RiebesellPareto 10000 * lomax 0.737
  note{Mack2003}
  tags{topic:severity, role:reference, role:paper};

sev Mata2005.Lognorm 11048 * lognorm 2.29
  note{Mata2005}
  tags{topic:severity, role:reference, role:paper};

sev Venter1983.Piecewise chistogram xps [0 1000 5000 6000 7000 8000 9000 10000 12500 15000 17500 20000 25000 35000 50000 75000 100000 125000 150000 175000 200000 225000 250000 300000] [0.38935 0.38935 0.00568 0.00543 0.00517 0.00495 0.00473 0.01098 0.00989 0.00896 0.00815 0.01426 0.02237 0.02353 0.02459 0.01517 0.01021 0.00732 0.00547 0.00423 0.00337 0.00274 0.0241]
  note{Venter1983. Piecewise linear claim size CDF to the 250,000 policy limit; the top bin carries the limit mass, so use only inside a 250000 xs 0 layer.}
  tags{topic:severity, role:reference, role:paper};

# ----------------------------------------------------------------------
# Frequency
# One law per entry, most on the unit severity so only the count varies.
# ----------------------------------------------------------------------

agg FixedFrequency
  10 claims
  dsev [1]
  fixed
  note{fixed claim count}
  tags{topic:frequency};

agg BernoulliFrequency
  0.8 claims
  dsev [1]
  bernoulli
  note{Bernoulli claim count with p=0.8}
  tags{topic:frequency};

agg BinomialFrequency
  10 claims
  dsev [1]
  binomial 0.5
  note{Binomial claim count with mean 10 and p = 0.5; binomial n=20 computed automatically. SD is (20 / 4)**.5 = 2.236.}
  tags{topic:frequency};

agg PoissonSimple
  10 claims
  dsev [1]
  poisson
  note{Poisson with claim count 10.}
  tags{topic:frequency};

agg GeometricFrequency
  10 claims
  dsev [1]
  geometric
  note{geometric claim count: number of failures before the first success for a Bernoulli(p), which has mean n=(1-p)/p. Parameterized using n rather than p. Variance is (1-p)/p^2 = n(n+1) and so CV sqrt((n+1)/n) --> 1 for large n.}
  tags{topic:frequency};

agg NegativeBinomialFrequency
  10 claims
  dsev [1]
  negbin 3
  note{negative binomial; shape parameter 3 equals variance multiplier}
  tags{topic:frequency};

agg NegativeBinomialMixed
  10 claims
  dsev [1]
  mixed gamma 0.65
  note{negative binomial as gamma mixed Poisson, shape parameter equals cv of mixing distribution}
  tags{topic:frequency};

agg InverseGaussianMixed
  10 claims
  dsev [1]
  mixed ig .65
  note{inverse Gaussian mixing distribution, shape parameter equals cv of mixing distribution}
  tags{topic:frequency};

agg ZTPoissonFrequency
  4 claims
  dsev [1]
  poisson zt
  note{Zero-truncated Poisson, at least one claim, so E[N] = 4/(1-exp(-4)) = 4.0746.}
  tags{topic:frequency};

agg ZMPoissonFrequency
  4 claims
  dsev [1]
  poisson zm 0.5
  note{Zero-modified Poisson, inflate the no-claim probability to 0.5. The 4 is the UN-MODIFIED base mean; reweighting leaves E[N] = 2.0373. Append ! to pin E[N] = 4 instead.}
  tags{topic:frequency};

agg ZMPoissonFrequency.Mean
  4 claims
  dsev [1]
  poisson zm 0.5 !
  note{Zero-modified Poisson, inflate the no-claim probability to 0.5 and retain mean 4. }
  tags{topic:frequency};

agg NeymanAFrequency
  10 claims
  dsev [1]
  neymana 4
  note{Neyman Type A claim count: a Poisson number of clusters, each contributing a Poisson number of claims. The parameter is the mean cluster size, so 10 claims in clusters of 4 means 2.5 clusters on average.}
  tags{topic:frequency};

# ----------------------------------------------------------------------
# Aggregates
# Exposure can be defined by claim count, loss amount, premium x loss ratio
# exposure x unit rate. Premium can be appended as an informational item.
# Also: lmits profile blends, and the Tweedie family.
# ----------------------------------------------------------------------

agg ExposureByClaimCount
  10 claims
  sev lognorm 50 cv 0.8
  poisson
  note{specify number of claims}
  tags{topic:aggregate};

agg ExposureByLoss
  500 loss 800 premium
  sev lognorm 50 cv 0.8
  poisson
  note{State expected loss; the claim count is derived. Premium is informational}
  tags{topic:aggregate};

agg ExposureByPremium
  1000 premium at 0.5 lr
  sev lognorm 50 cv 0.8
  poisson
  note{State premium and a loss ratio; the claim count is derived.}
  tags{topic:aggregate};

agg ExposureLimitProfile
  [10_000 20_000 5_000 5_000] premium at [0.8 0.7 0.6 0.5] lr
  [1_000 2_000 5_000 5_000] xs [0 0 0 250]
  sev lognorm 150 cv 1.5
  poisson
  note{Premium x limit x loss-ratio profile, implied claim counts computed per band.}
  tags{role:hero, topic:aggregate, check:reconciliation};

agg ExactHard
  5000 claims
  sev lognorm 100 cv 4
  poisson
  note{Exact computation difficult because of severity. Viewed on log scale two regiemes (large and small losses) clearly evident.}
  tags{topic:aggregate};

agg ApproximateHard
  5000 claims
  sev lognorm 100 cv 4
  poisson approximate slognorm
  note{Approximation using shifted lognormal. Viewed on a log scale this has the wrong shape.}
  tags{topic:aggregate}

agg TweedieDirect
  tweedie 1.1 100 1.5
  note{Tweedie defined by p, mean, and dispersion using the tweedie keyword; variance = dispersion * mean**p. Use tweedie_convert method to translate parameters.}
  tags{topic:aggregate topic:tweedie};

agg TweedieFromMoments
  100**(2-1.1)/((2-1.1)*1.5) claims
  sev gamma (1.5*(2-1.1)*100**(1.1-1)) cv ((1.1-1)/(2-1.1))**0.5
  poisson
  note{Tweedie defined by claim count, gamma mean and cv, every number written as DecL arithmetic in the p = 1.1, mean = 100 and dispersion = 1.5 of TweedieDirect.}
  tags{topic:aggregate topic:tweedie};

agg TweedieFreqSev
  100**(2-1.1)/((2-1.1)*1.5) claims
  sev (1.5*(1.1-1)*100**(1.1-1)) * gamma ((2-1.1)/(1.1-1))
  poisson
  note{Tweedie defined by claim count, gamma scale and shape, every number written as DecL arithmetic in the p = 1.1, mean = 100 and dispersion = 1.5 of TweedieDirect.}
  tags{topic:aggregate};

agg TweedieMultiModal
    tweedie 1.005 1.0 0.1
    note{An extreme Tweedie with p very close to 1 is "like" a Poisson and has a highly multimodal density function.}
    tags{topic:aggregate topic:tweedie};

# ----------------------------------------------------------------------
# Aggregates with reinsurance
# GrossCatXOL is the gross view of the USXOLTower program that follows it.
# ----------------------------------------------------------------------

agg GrossCatXOL as "Gross US Hurricane"
  1.74 claims
  sev lognorm 8.501 cv 14.624
  poisson
  note{ILW model on US Cat, amounts in billions. Gross of the USXOLTower program.}
  tags{topic:aggregate}
  hints{bs=2;log2=16;normalize=False;};

agg USXOLTower as "US Hurricane Reinsurance"
  1.74 claims
  sev lognorm 8.501 cv 14.624
  occurrence net of
    90% po 100 xs 100 deposit 4 and
    95% po 200 xs 200 deposit 3.75 as "Occ re"
  poisson
  aggregate net of
    50% po 20 xs 100 deposit 3 as "Agg re"
  note{ILW model of US Cat. Amounts in billions. From St John's RMI3388 course. Industry estimates, as of 2019: 100 year PML USD132.5B and 250 year USD300.3B.}
  tags{role:hero, topic:reinsurance}
  hints{bs=2;log2=16;normalize=False;};

agg OccurrenceXOL
  100 claims
  1_000 xs 0
  sev lognorm 100 cv 2
  occurrence net of
    90% po 875 xs 125
  poisson
  note{Occurrence program, partially placed at 90%.}
  tags{topic:reinsurance};

agg AggregateStopLoss
  100 claims
  1_000 xs 0
  sev lognorm 100 cv 2
  poisson
  aggregate net of
    1930 xs 9870
  note{Aggregate stop-loss from 60% attachment to 90% detachment.}
  tags{topic:reinsurance};

agg OccurrenceXOLProgram
  15 claims
  10_000 xs 0
  sev lognorm 1500 cv 3
  occurrence net of
    50% po 2500 xs 2500 and
    90% po 5000 xs 5000
  mixed gamma 0.25
  note{Occurrence excess-of-loss program, net view.}
  tags{topic:reinsurance, check:reconciliation};

agg ReinsuranceOccurrenceTower
  dfreq[1]
  sev 125 * uniform
  occurrence ceded to tower [0 25 50 75 100 125]
  note{An occurrence reinsurance tower; look at Reinsurance->Stats in aLL to see layer losses.}
  tags{topic:reinsurance};

agg ReinsuranceOccurrenceTower.Agg
  10 claims
  sev 125 * uniform
  occurrence ceded to tower [0 25 50 75 100 125]
  poisson
  note{An occurrence reinsurance tower in an aggregate book.}
  tags{topic:reinsurance};

agg ReinsuranceOccurrenceWithAggLimit
  5 claims
  120 xs 0
  sev 120 * uniform
  occurrence ceded to
    60 xs 60
  poisson
  aggregate ceded to
    180 xs 0
  note{occurrence with an aggregate limit}
  tags{topic:reinsurance};

agg ReinsuranceLayered
  1250 premium at 0.8 lr
  1000 xs 0
  sev lognorm 80 cv 1.675
  occurrence ceded to
    125 xs 0 and
    50% po 125 xs 125 and
    20% po 250 xs 250 and
    5% po 500 xs 500
  poisson
  note{Layered occurrence reinsurance tower with partial placements, ceded view.}
  tags{topic:reinsurance};

agg ReinsuranceExposureRating
  [10000 20000 10000 5000] premium at [0.9 0.85 0.9 0.8] lr
  [250 500 1000 2000] xs 0
  sev lognorm 120 cv 5
  occurrence ceded to
    500 xs 500 and
    1000 xs 1000
  mixed gamma 0.2
  hints{log2=16; bs=2}
  note{Exposure rating on a small portfolio with limits profile, amounts in 000s.}
  tags{role:hero, topic:reinsurance};

agg ReinsuranceExposureRating.Check
  5000 premium at 0.8 lr
  2000 xs 0
  sev lognorm 120 cv 5
  occurrence ceded to
    500 xs 500 and
    1000 xs 1000
  mixed gamma 0.2
  hints{log2=16; bs=2}
  note{Check on top layer of ReinsuranceExposureRating, which is only exposed by the 2000 limit bucket.}
  tags{role:hero, topic:reinsurance};

agg LayerPicks.Uniform
  dfreq[1]
  sev 100 * uniform picks [50 75 100] [30 12 5]
  note{Layer loss picks: adjust the severity curve to match selected picks by layer. Adjusts the mean.}
  tags{topic:reinsurance, topic:picks}

agg LayerPicks.Lognorm.Exposure
  dfreq[1]
  1000 xs 0
  sev (100 / exp(1.5**2/2)) * lognorm 1.5
  occurrence ceded to tower [0 125 250 500 1000]
  note{Exposure rating layering, look at Reinsurance->Summary for loss picks by layer.}
  tags{topic:reinsurance, topic:picks}

agg LayerPicks.Lognorm.Experience
  dfreq[1]
  1000 xs 0
  sev (100 / exp(1.5**2/2)) * lognorm 1.5
      picks [125 250 500 1000] [30 20 20 18]
  occurrence ceded to tower [0 125 250 500 1000]
  note{Layer loss picks with quite an extreme adjustment. Run with ceded to tower [0 100 200 500] to discover loss picks by layer.}
  tags{topic:reinsurance, topic:picks}

port Compare
  note{Compare adjusted and unadjusted severity in a portfolio.}
  tags{topic:reinsurance, topic:picks}
  agg LayerPicks.Lognorm.Exposure
    dfreq[1]
    1000 xs 0
    sev (100 / exp(1.5**2/2)) * lognorm 1.5
  agg LayerPicks.Lognorm.Experience
    dfreq[1]
    1000 xs 0
    sev (100 / exp(1.5**2/2)) * lognorm 1.5
      picks [125 250 500 1000] [30 20 20 18]

agg MED.Exposure
  1 claim
  sev [2764 24548 275654 1917469 10000000] * expon wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  occurrence ceded to tower [0 100000 250000 500000 1000000 5000000]
  fixed
  note{Layer loss picks. Must use 1 claim ... fixed; dfreq is fixed whereas fixed is a *family* of fixed distributions.}
  tags{topic:reinsurance, topic:picks}
  hints{bs=125; log2=18};

agg MED.WithPicks
  1 claim
  sev [2764 24548 275654 1917469 10000000] * expon wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  picks [100000 250000 500000 1000000 5000000] [7000 1500 1500 1500 2250]
  occurrence ceded to tower [0 100000 250000 500000 1000000 5000000]
  fixed
  note{Layer loss picks: the CommAutoMixedExponential reweighted to achieve desired picks.}
  tags{topic:reinsurance, topic:picks}
  hints{bs=125; log2=18};

agg MED.Picks
  1 claim
  sev [2764 24548 275654 1917469 10000000] * expon
    wts [0.824796 0.159065 0.014444 0.001624 7.1e-05]
  occurrence ceded to tower [100000 250000 500000 1000000 5000000]
  fixed


# ----------------------------------------------------------------------
# Inner/outer aggregates: one aggregate as the severity of another.
# Each pair is inner then outer, and the inner must come first: the outer
# records `sev agg.NAME` at parse time and the underwriter resolves it
# when the outer is built.
# ----------------------------------------------------------------------

agg NeymanCluster
  4 claims
  dsev [1]
  poisson
  note{One cluster of a Neyman Type A: a Poisson(4) count on a unit severity. The inner half of the construction NeymanInnerOuter assembles.}
  tags{topic:frequency}
  hints{bs=1; log2=8};

agg NeymanInnerOuter
  2.5 claims
  sev agg.NeymanCluster
  poisson
  note{Neyman Type A assembled by hand: a Poisson(2.5) number of NeymanCluster draws, overall mean 10. The same distribution the neymana keyword produces.}
  tags{topic:frequency, check:cross-object}
  hints{bs=1; log2=10};

agg NeymanKeyword
  10 claims
  dsev[1]
  neyman 4
  note{Neyman Type A using the neyman decl keyword. Agrees with agg.NeymanInnerOuter}
  tags{topic:frequency, check:cross-object}
  hints{bs=1; log2=10};

agg SplitLimitClaimant
  1.25 claims
  100 xs 0
  sev lognorm 50 cv 2
  poisson zt !
  note{Claimants in one US auto 100/300 split limit accident: at least one claimant, 1.25 on average, each capped at the 100 per claimant limit. Using zero truncated Poisson, reparameterized to achieve desired mean.}
  tags{topic:frequency, topic:severity}
  hints{bs=1/4; log2=13};

agg SplitLimitPolicy
  100 claims
  300 xs 0
  sev agg.SplitLimitClaimant
  poisson
  note{100 US auto policies written 100/300: the per accident loss of SplitLimitClaimant is the severity, capped at the 300 per accident limit.}
  tags{topic:aggregate, topic:severity, check:reconciliation}
  hints{bs=1/4; log2=17};

# ----------------------------------------------------------------------
# Bivariate and dependent risks
# By copula first, then the common-shock and net / ceded joint views.
# ----------------------------------------------------------------------

bivariate BivariateIndependent
  25 claims
  agg A
    dfreq [1]
    ssev lognorm 50 cv .25 - 25
  agg B
    dfreq [1]
    ssev gamma 50 cv 0.25 - 25
  copula independent
  poisson
  note{Bivariate, positive and negative support.}
  tags{topic:bivariate};

bivariate BivariateNormal
  25 claims
  agg A
    dfreq [1]
    sev lognorm 50 cv 1.5
  agg B
    dfreq [1]
    sev gamma 50 cv 1
  copula normal 0.5
  poisson
  tags{topic:bivariate};

bivariate BivariateClaytonMixed
  25 claims
  agg Wind
    dfreq [0 1] [0.3 0.7]
    sev lognorm 40 cv 1.2
  agg Flood
    dfreq [0 1] [0.2 0.8]
    sev lognorm 60 cv 1.5
  copula clayton 0.3
  mixed gamma 0.2
  tags{topic:bivariate};

bivariate BivariateGumbel
  25 claims
  agg Wind
    dfreq [0 1] [0.3 0.7]
    sev lognorm 40 cv 1.2
  agg Flood
    dfreq [0 1] [0.1 0.9]
    sev lognorm 60 cv 1.5
  copula gumbel 0.4
  poisson
  note{Gumbel-copula dependence between Wind and Flood.}
  tags{role:hero, topic:bivariate};

bivariate BivariateCatPair
  25 claims
  agg Wind
    dfreq [0 1] [0.3 0.7]
    sev lognorm 40 cv 0.65 splice [0] [250]
  agg Flood
    dfreq [0 1] [0.1 0.9]
    sev lognorm 60 cv 0.95 splice [0] [300]
  copula independent
  mixed gamma 0.2
  note{Common-shock bivariate (bv): Wind and Flood share frequency mixing.}
  tags{topic:bivariate};

netceded
  agg BivariateNetCeded
    8 claims
    sev 300 * beta 2 3
    occurrence net of
      50% po 250 xs 50
    poisson
    note{Bivariate distribution of net and ceded for an XOL reinsurance program.}
    tags{topic:bivariate, topic:reinsurance};

netceded
  agg BivariateNetCededPair
    15 claims
    10000 xs 0
    sev lognorm 1500 cv 1
    occurrence net of
      50% po 2500 xs 2500 and
      90% po 5000 xs 5000
    mixed gamma 0.25
    note{Gross / ceded / net joint view of a reinsured book.}
    tags{topic:bivariate, topic:reinsurance};

# ----------------------------------------------------------------------
# Profit and loss (signed support)
# USHurr refers to agg.USXOLTower, declared in the reinsurance section.
# ----------------------------------------------------------------------

pnl PnLSimple
  inherit premium
  less
    agg PnL.A
      1000 premium at 0.9 lr
      1000 xs 0
      sev lognorm 120 cv 1
      mixed gamma 0.25
  note{Single profit-and-loss line.}
  tags{topic:pnl};

pnl PnLClaims
  100 premium
  less
    agg PnL.B
      10 claims
      sev lognorm 8 cv 1.5
      poisson
  note{claims form: premium independent of the loss model}
  tags{topic:pnl};

pnl PnLLoss
  100 premium
  less
    agg PnL.C
      85 loss
      sev lognorm 8 cv 1.5
      poisson
  note{expected-loss form: E[loss]=85, margin 15}
  tags{topic:pnl};

pnl PnLLossRatio
  1000 premium
  less
    agg PnL.D
      1000 premium at 0.7 lr
      sev lognorm 100 cv 2
      poisson
  note{loss ratio form: E[loss]=700, margin 300}
  tags{topic:pnl};

pnl PnLVector
  [100 200 100] premium
  less
    agg PnL.E
      [100 200 100] premium at 0.8 lr
      [1000 2000 5000] xs 0
      sev lognorm 500 cv 2
      poisson
  note{Vector premium: shift 400, mean 80 = sum premium_i (1 - lr).}
  tags{topic:pnl};

pnl PnLSignedDsev
  5 premium
  less
    agg PnL.F
      dfreq [3]
      dsev [-1 1]
  note{signed loss: PnL in (2,4,6,8), mean 5, sd sqrt3}
  tags{topic:pnl};

pnl PnLSignedAsymmetric
  10 premium
  less
    agg PnL.G
      dfreq [2]
      dsev [-2 1 3] [0.5 0.3 0.2]
  note{non-symmetric signed dsev: mean = 10 - 2 E[X] = 10.2}
  tags{topic:pnl};

pnl PnLSignedSsev 100 premium less
  agg PnL.H
    5 claims
    ssev 20 - lognorm 10 cv 0.5
    poisson
  note{continuous signed severity: E[loss]=50, margin 50}
  tags{topic:pnl};

port PnLBook
  tags{topic:portfolio, topic:pnl}
  pnl Cat
    2000 premium
    less
      agg PNL.Cat
        2000 premium at 0.55 lr
        sev lognorm 500 cv 3
        poisson
  pnl Prop
    5000 premium
    less
      agg PNL.Prop
        5000 premium at 0.65 lr
        sev lognorm 100 cv 2
        poisson;

agg SignedSeverity
  dfreq [3]
  dsev [-2 5]
  note{Signed severity, negative outcomes allowed; three fixed draws give the closed-form support -6, 1, 8, 15.}
  tags{topic:aggregate};

agg SignedStandardDeviation
  dfreq [3]
  dsev [-1 1]
  note{zero-mean signed; sev SD 1, agg SD sqrt(3), derived from ex2, not mean*cv}
  tags{topic:aggregate};

agg SignedNormal
  100 claims
  ssev 50 * norm + 10
  poisson
  note{continuous signed (ssev) P&L severity; never clamps}
  tags{topic:aggregate};

agg SignedLump
  1000000 claims
  dsev [-1 10] [0.9375 0.0625]
  poisson
  note{near-Gaussian lump at a negative mean ~ -312500; auto window}
  tags{topic:aggregate};

agg SignedPremiumMinusLoss
  5 claims
  ssev 100 - lognorm 95 cv .2
  poisson
  note{premium minus loss: "constant - distribution" reflects the severity, mean 5.}
  tags{topic:aggregate};

agg SignedPremiumMinusLossNormal
  5000 claims
  ssev 100  - lognorm 95 cv 1.2
  poisson
  note{High-frequency premium-minus-loss payoff with a certain claim and exposure variability; near-Gaussian on a signed window.}
  tags{topic:aggregate}

port SignedGotcha
  note{The sev side of the sev / ssev contrast: a spliced sev clamps the normal to a non-negative window, so the two units are bounded below where SignedPortfolioPair is not.}
  tags{topic:portfolio, topic:pnl}
  agg A
    1 claim
    sev 10 * norm + 25
    fixed
  agg B
    1 claim
    sev 10 * norm + 5
    fixed;

port SignedPortfolioPair
  note{The ssev side of the sev / ssev contrast: two signed normal units, offset either way, on one signed window.}
  tags{topic:portfolio, topic:pnl}
      agg A
        1 claim
        ssev 10 * norm + 25
        fixed
      agg B
        1 claim
        ssev 10 * norm + 5
        fixed;

port SignedPortfolioMixed
  tags{topic:portfolio, topic:pnl}
  agg Loss
    30 claims
    sev lognorm 20 cv 0.8
    poisson
  agg PnL
    50 claims
    ssev 10 * norm
    poisson;

# ----------------------------------------------------------------------
# Numerical character
# Moment approximations, window and grid behavior, and the small books the
# pricing surfaces are hand checked against.
# ----------------------------------------------------------------------

agg RawGamma
  5000 claims
  sev lognorm 100 cv 2
  poisson
  note{Raw distribution, hard to calibrate, two-regieme shape.}
  tags{topic:numerics};

agg ApproximateGamma
  5000 claims
  sev lognorm 100 cv 2
  poisson
  approximate sgamma
  note{Shifted-gamma moment approximation.}
  tags{topic:numerics};

agg ApproximateRightSlognorm
  5000 claims
  sev lognorm 100 cv 2
  poisson
  approximate slognorm
  note{Shifted-lognomral moment approximation.}
  tags{topic:numerics};

agg HeavyTailValidation
  10 claims
  sev 100 * lomax 1.3
  poisson
  note{Infinite-variance Pareto, the validator refuses to guess, must pass bs. Tail of aggregate and severity parallel on log scale.}
  tags{topic:numerics}
  hints{bs=0.25; log2=16};

agg WindowedSimple
  10_000_000 claims
  dsev [1 2]
  poisson
  note{Concentrated high-mean book, resolved on a non-zero output window.}
  tags{topic:numerics};

agg WindowContinuous
  100000 claims
  sev lognorm 100 cv 0.5
  poisson
  note{Very high claim count results in windowed FFT.}
  tags{topic:numerics};


# ----------------------------------------------------------------------
# Portfolios
# Two units at a time, from the plain pair to the diversification archetypes.
# ----------------------------------------------------------------------

port BasicPortfolio
  note{Two-unit portfolio.}
  tags{topic:portfolio}
  agg A
    50 claims
    1000 xs 0
    sev lognorm 100 cv 1.2
    mixed gamma 0.4
  agg B
    65 claims
    2000 xs 0
    sev lognorm 150 cv 1.6
    mixed gamma 0.2;

port TwoLineBook
  note{Two-unit book: thin property + mixed-frequency casualty. Capital and price downstream.}
  tags{role:hero, topic:portfolio}
  agg Property
    80 claims
    500 xs 0
    sev lognorm 50 cv 1.2
    poisson
  agg Casualty
    20 claims
    2000 xs 0
    sev lognorm 250 cv 2
    mixed gamma 0.4;

port PropertyCasualty
  note{Portfolio of property and casualty risks, amounts in 000s.}
  tags{role:hero, topic:portfolio}
  agg Casualty
    5000 premium at 0.9 lr
    5000 xs 0
    sev lognorm 200 cv 8
    mixed gamma 0.45
  agg Property
    4000 premium at 0.85 lr
    10000 xs 0
    sev lognorm 250 cv 12
    mixed gamma 0.15;

port ThinThinPortfolio
  note{Two thin, concentrated units, nearly Gaussian total.}
  tags{topic:portfolio}
  agg A
    1 claim
    sev gamma 50 cv 0.1
    fixed
  agg B
    1 claim
    sev gamma 50 cv 0.15
    fixed;

port ThickThinPortfolio
  note{Thin attritional + bounded-but-thick cat, the rich diversification case.}
  tags{topic:portfolio}
  agg NonCat
    200 claims
    100 xs 0
    sev gamma 8 cv 0.3
    poisson
  agg Cat
    2 claims
    5000 xs 0
    sev lognorm 500 cv 4
    poisson;

port ThickThickPortfolio
  note{Two unbounded heavy-tailed units, little diversification, tail-driven.}
  tags{topic:portfolio}
  agg A
    100 claims
    sev lognorm 50 cv 3
    poisson
  agg B
    100 claims
    sev lognorm 80 cv 3.5
    poisson;

port DiscretePortfolio
  note{signed totals.}
  tags{topic:portfolio, topic:pnl, topic:numerics}
  agg A
    dfreq [1 2]
    dsev [-3 -1 2] [0.5 0.3 0.2]
  agg B
    dfreq [1]
    dsev [-2 1 4]
  agg C
    dfreq [2]
    dsev [1 3];

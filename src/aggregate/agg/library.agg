pnl PnLClaims 100 prem less agg PnLprem.Claims_e 10 claims sev lognorm 8 cv 1.5 poisson note{claims form: premium independent of the loss model} tags{topic:pnl};
pnl PnLLoss 100 prem less agg PnLprem.Loss_e 85 loss sev lognorm 8 cv 1.5 poisson note{expected-loss form: E[loss]=85, margin 15} tags{topic:pnl};
pnl PnLLossRatio 1000 prem less agg PnLprem.LR_e 1000 prem at 70% lr sev lognorm 100 cv 2 poisson note{loss ratio form: E[loss]=700, margin 300} tags{topic:pnl};
pnl PnLMixed [100 200 100] prem less agg E.PnLMix_e [100 200 100] prem at .8 lr [1000 2000 5000] xs 0 sev lognorm 500 cv 2 poisson note{Vector premium: shift 400, mean 80 = sum premium_i (1 - lr).} tags{topic:pnl};
port PnLPortfolio tags{topic:portfolio, topic:pnl} pnl Cat 2000 prem less agg Cat_e 2000 prem at 55% lr sev lognorm 500 cv 3 poisson pnl Prop 5000 prem less agg Prop_e 5000 prem at 65% lr sev lognorm 100 cv 2 poisson note{Portfolio of two profit-and-loss units.};
pnl PnLSignedAsymmetric 10 premium less agg PnLsigned.Asym_e dfreq[2] dsev[-2 1 3] [.5 .3 .2] note{non-symmetric signed dsev: mean = 10 - 2 E[X] = 10.2} tags{topic:pnl};
pnl PnLSignedDsev 5 premium less agg PnLsigned.Dsev_e dfreq[3] dsev[-1 1] note{signed loss: PnL in (2,4,6,8), mean 5, sd sqrt3} tags{topic:pnl};
pnl PnLSignedSsev 100 premium less agg PnLsigned.Ssev_e 5 claims ssev 20 - lognorm 10 cv 0.5 poisson note{continuous signed severity: E[loss]=50, margin 50} tags{topic:pnl};
pnl PnLSimple 1000 prem less agg E.PNL_e 1000 prem at 90% lr 1000 xs 0 sev lognorm 120 cv 1 mixed gamma .25 note{Single profit-and-loss line.} tags{topic:pnl};
pnl PnLVector [100 200 100] prem less agg PnLprem.Vec_e [100 200 100] prem at .8 lr [1000 2000 5000] xs 0 sev lognorm 500 cv 2 poisson note{vector premium: shift 400, mean 80 = sum premium_i (1-lr)} tags{topic:pnl};
agg SignedFixed dfreq [3] dsev [-2 5] [.5 .5] note{fixed-3; closed form support (-6,1,8,15)} tags{topic:pnl};
port SignedGotcha tags{topic:portfolio, topic:pnl} agg A 50 claims sev 10 * norm + 5 splice [0 40] poisson agg B 50 claims sev 10 * norm - 5 splice [0 35] poisson;
agg SignedLump 1e6 claims dsev [-1 10] [15/16 1/16] poisson note{near-Gaussian lump at a negative mean ~ -312500; auto window} tags{topic:pnl};
agg SignedNormal 100 claims ssev 50 * norm + 10 poisson note{continuous signed (ssev) P&L severity; never clamps} tags{topic:pnl};
port SignedPortfolioMixed tags{topic:portfolio, topic:pnl} agg Loss 30 claims sev lognorm 20 cv 0.8 poisson agg PnL 50 claims ssev 10 * norm poisson;
port SignedPortfolioPair tags{topic:portfolio, topic:pnl} agg A 50 claims ssev 10 * norm + 5 poisson agg B 50 claims ssev 10 * norm - 5 poisson;
agg SignedPremiumMinusLoss 5 claims ssev 100 - lognorm 80 cv .2 poisson note{premium minus loss: constant - dist reflects the severity (sev mean 20)} tags{topic:pnl};
agg SignedSeverity dfreq [3] dsev [-2 5] [.5 .5] note{Signed severity -- negative outcomes allowed (closed-form support).} tags{topic:severity, topic:pnl};
agg SignedSeveritySimple dfreq [3] dsev [-2 5] [.5 .5] note{Signed severity -- negative outcomes allowed.} tags{topic:severity, topic:pnl};
agg SignedStandardDeviation dfreq [3] dsev [-1 1] note{zero-mean signed; sev SD 1, agg SD sqrt(3) -- derived from ex2, not mean*cv} tags{topic:pnl};
agg SignedSymmetric 20 claims dsev [-1 1] [.5 .5] poisson note{symmetric P&L; mean 0} tags{topic:pnl};

# ----------------------------------------------------------------------
# Portfolios
# ----------------------------------------------------------------------
port BasicPortfolio tags{topic:portfolio} agg A 50 claims 1000 xs 0 sev lognorm 100 cv 1.2 mixed gamma 0.4 agg B 65 claims 2000 xs 0 sev lognorm 150 cv 1.6 mixed gamma 0.2 note{Two-unit portfolio.};
port SevVersusSsev tags{topic:portfolio, topic:severity} agg A 50 claims ssev 10 * norm + 5 poisson agg B 50 claims ssev 10 * norm - 5 poisson;
port SharedMixPortfolio tags{topic:portfolio} agg A 100 claims sev lognorm 50 cv 1.5 mixed gamma 0.4 agg B 120 claims sev lognorm 60 cv 1.5 mixed gamma 0.4 note{Shared frequency mixer = common shock; correlated units on one grid.};
port ThickThickPortfolio tags{topic:portfolio} agg A 100 claims sev lognorm 50 cv 3.0 poisson agg B 100 claims sev lognorm 80 cv 3.5 poisson note{Two unbounded heavy-tailed units -- little diversification, tail-driven.};
port ThickThinPortfolio tags{topic:portfolio} agg NonCat 200 claims 100 xs 0 sev gamma   8 cv 0.30 poisson agg Cat      2 claims 5000 xs 0 sev lognorm 500 cv 4.0 poisson note{Thin attritional + bounded-but-thick cat -- the rich diversification case.};
port ThinThinPortfolio tags{topic:portfolio} agg A 1 claim sev gamma 50 cv 0.10 fixed agg B 1 claim sev gamma 50 cv 0.15 fixed note{Two thin, concentrated units -- nearly Gaussian total.};

# ----------------------------------------------------------------------
# Bivariate and dependent risks
# ----------------------------------------------------------------------
bv BivariateCatPair 25 claims agg Wind dfreq [0 1] [.3 .7] sev lognorm 40 cv 0.65 splice [0 250] agg Flood dfreq [0 1] [.5 .5] sev lognorm 60 cv 0.95 splice [0 300] mixed gamma .2 note{Common-shock bivariate (bv): Wind and Flood share frequency mixing.} tags{topic:bivariate};
bivariate BivariateClaytonMixed 25 claims agg Wind dfreq [0 1] [.3 .7] sev lognorm 40 cv 1.2 agg Flood dfreq [0 1] [.5 .5] sev lognorm 60 cv 1.5 copula clayton 0.3 mixed gamma .2 tags{topic:bivariate};
bivariate BivariateGumbel 25 claims agg Wind dfreq [0 1] [.3 .7] sev lognorm 40 cv 1.2 agg Flood dfreq [0 1] [.5 .5] sev lognorm 60 cv 1.5 copula gumbel 0.4 poisson tags{topic:bivariate};
bivariate BivariateGumbelPair 25 claims agg Wind dfreq [0 1] [.3 .7] sev lognorm 40 cv 1.2 agg Flood dfreq [0 1] [.5 .5] sev lognorm 60 cv 1.5 copula gumbel 0.4 poisson note{Gumbel-copula dependence between Wind and Flood.} tags{topic:bivariate};
bivariate BivariateIndependent 25 claims agg A dfreq [0 1] [.5 .5] sev lognorm 50 cv 1.5 agg B dfreq [0 1] [.5 .5] sev gamma 50 cv 1.0 poisson tags{topic:bivariate};
netceded agg BivariateNetCeded 8 claims sev 300 * beta 2 3 occurrence net of 0.7 so 60 xs 40 poisson tags{topic:bivariate, topic:reinsurance};
netceded agg BivariateNetCededPair 15 claims 10000 xs 0 sev lognorm 1500 cv 1.0 occurrence net of 50% po 2500 xs 2500 and 90% po 5000 xs 5000 mixed gamma 0.25 note{Gross / ceded / net joint view of a reinsured book.} tags{topic:bivariate, topic:reinsurance};
bivariate BivariateNormal 25 claims agg A dfreq [0 1] [.5 .5] sev lognorm 50 cv 1.5 agg B dfreq [0 1] [.5 .5] sev gamma 50 cv 1.0 copula normal 0.5 tags{topic:bivariate};
bivariate BivariatePnLAxis 25 claims agg A dfreq [0 1] [.3 .7] sev lognorm 40 cv 1.2 pnl B 900 prem less agg B_e dfreq [0 1] [.5 .5] sev lognorm 60 cv 1.5 copula gumbel 0.4 poisson tags{topic:bivariate};
netceded agg NetCededJoint 15 claims 10000 xs 0 sev lognorm 1500 cv 1.0 occurrence net of 50% po 2500 xs 2500 and 90% po 5000 xs 5000 mixed gamma 0.25 note{Joint gross / ceded / net view of the reinsured book.} tags{topic:bivariate, topic:reinsurance};
netceded agg NetCededShowcase 8 claims sev 300 * beta 2 3 occurrence net of 0.7 so 60 xs 40 poisson note{Bivariate distribution of net and ceded for XOL reinsurance program.} tags{topic:bivariate, topic:reinsurance};

# ----------------------------------------------------------------------
# Distortions (risk measures)
# ----------------------------------------------------------------------
dist CCoCDistortion ccoc .25 tags{topic:distortion};
dist DualDistortionSimple dual 2.5 tags{topic:distortion};
dist MinimumDistortion minimum dist.PHDistortion dist.DualDistortion tags{topic:distortion};
dist PHDistortionSimple ph 0.65 tags{topic:distortion};
dist TVaRDistortion tvar 0.4 tags{topic:distortion};
dist WangDistortion ph 0.7 tags{topic:distortion};

# ----------------------------------------------------------------------
# Numerical character
# ----------------------------------------------------------------------
agg ApproximateAggReins 100 claim sev lognorm 100 cv 2 poisson aggregate net of 100 xs 0 approximate sgamma tags{topic:numerics};
agg ApproximateGamma 5000 claim sev lognorm 100 cv 2 poisson approximate sgamma note{Shifted-gamma moment approximation.} tags{topic:numerics};
agg ApproximateLeftReflect 1 claim sev 100 * beta 5 1.3 fixed approximate sgamma tags{topic:numerics};
pnl ApproximatePnL 600000 prem less agg APX.PnL_e 5000 claim sev lognorm 100 cv 2 poisson approximate sgamma tags{topic:pnl, topic:numerics};
agg ApproximateRightSgamma 5000 claim sev lognorm 100 cv 2 poisson approximate sgamma tags{topic:numerics};
agg ApproximateRightSlognorm 5000 claim sev lognorm 100 cv 2 poisson approximate slognorm tags{topic:numerics};
agg HeavyTailValidation 10 claims sev 100 * pareto 1.3 - 100 poisson hints{bs=0.25; log2=16} note{Infinite-variance Pareto -- the validator refuses to guess.} tags{topic:numerics};
agg NumericsDice dfreq [1:6] dsev [1:6] note{six-surface consistency target; choquet hand checks} tags{topic:numerics};
port NumericsOneDice tags{topic:portfolio, topic:numerics} agg D dfreq [1:6] dsev [1:6] note{one-line port: line == total};
port NumericsPayPair tags{topic:portfolio, topic:numerics} pnl P1 10 prem less agg P1_e dfreq [1] dsev [2 5] [.5 .5] pnl P2 8 prem less agg P2_e dfreq [1] dsev [1 3] note{homogeneous payoff book prices through the dual};
port NumericsSignedDiscrete tags{topic:portfolio, topic:pnl, topic:numerics} agg A dfreq [1 2] dsev [-3 -1 2] [.5 .3 .2] agg B dfreq [1] dsev [-2 1 4] agg C dfreq [2] dsev [1 3] note{signed totals price via dot(kappa, gp); shares NaN};
port NumericsUnbounded tags{topic:portfolio, topic:numerics} agg U 5 claims sev lognorm 10 cv 1 poisson note{mass-on-unbounded refused in the lifted builder (G6)};
agg WindowContinuous 100000 claims sev lognorm 100 cv 0.5 poisson tags{topic:numerics};
agg WindowDiscrete 10000000 claims dsev [1 2] poisson tags{topic:numerics};
agg WindowedGrid 10000000 claims dsev [1 2] poisson note{Concentrated high-mean book -- resolved on a non-zero output window.} tags{topic:numerics};
agg WindowedSimple 10_000 claims dsev [-1 1] poisson note{Windowed / discrete severity at high frequency.} tags{topic:numerics};

# ----------------------------------------------------------------------
# Book and paper reproductions
# ----------------------------------------------------------------------
port BodoffOne tags{topic:portfolio, role:paper} note{Bodoff Thought Experiment No. 1} agg wind1 1 claim sev dhistogram xps [0, 99] [0.80, 0.20] fixed agg quake1 1 claim sev dhistogram xps [0, 100] [0.95, 0.05] fixed;
port BodoffOneNet tags{topic:portfolio, role:paper} note{Bodoff Thought Experiment No. 1} agg wind1 1 claim dsev [0, 99] [0.80, 0.20] fixed agg quake1 1 claim dsev [0, 100] [0.95, 0.05] fixed;
port BodoffThree tags{topic:portfolio, role:paper} note{Bodoff Thought Experiment No. 3} agg wind3 1 claim sev dhistogram xps [0, 5] [0.80, 0.20] fixed agg quake3 1 claim sev dhistogram xps [0, 100] [0.95, 0.05] fixed;
port BodoffThreeNet tags{topic:portfolio, role:paper} note{Bodoff Thought Experiment No. 3} agg wind3 1 claim sev dhistogram xps [0, 5] [0.80, 0.20] fixed agg quake3 1 claim sev dhistogram xps [0, 100] [0.95, 0.05] fixed;
port BodoffTwo tags{topic:portfolio, role:paper} note{Bodoff Thought Experiment No. 2} agg wind2 1 claim sev dhistogram xps [0, 50] [0.80, 0.20] fixed agg quake2 1 claim sev dhistogram xps [0, 100] [0.95, 0.05] fixed;
port BodoffTwoNet tags{topic:portfolio, role:paper} note{Bodoff Thought Experiment No. 2} agg wind2 1 claim dsev [0, 50] [0.80, 0.20] fixed agg quake2 1 claim dsev [0, 100] [0.95, 0.05] fixed;
port BodoffWindQuake tags{role:hero, topic:portfolio, role:paper} agg Wind  1 claim dsev [0 99]  [0.80 0.20] fixed agg Quake 1 claim dsev [0 100] [0.95 0.05] fixed note{Bodoff thought-experiment -- discrete two-peril allocation.};
agg DefectivePareto 1 claim sev 1000 * pareto 1.5 - 1000 fixed note{defective; no finite 2nd moment} hints{normalize=False} tags{role:paper};
port NumericsBodoff tags{topic:portfolio, role:paper, topic:numerics} agg wind 1 claim sev dhistogram xps [0, 99] [0.80, 0.20] fixed agg quake 1 claim sev dhistogram xps [0, 100] [0.95, 0.05] fixed note{bounded discrete; linear vs lifted; mass distortion exact};
port PIRCatNonCatGross tags{topic:portfolio, role:paper} note{PIR Cat-Noncat gross case study.} agg CNC.NonCat 1 claim sev gamma 80 cv 0.15 fixed agg CNC.Cat 1 claim sev lognorm 20 cv 1.00 fixed hints{bs=1/64; log2=16; padding=1};
port PIRCatNonCatNet tags{topic:portfolio, role:paper} note{PIR Cat-Noncat net case study.} agg CNC.Net.NonCat 1 claim sev gamma 80 cv 0.15 fixed agg CNC.Net.Cat 1 claim sev lognorm 20 cv 1.00 fixed aggregate net of 79.64 xs 41.11 hints{bs=1/64; log2=16; padding=1};
port PIRDiscrete tags{topic:portfolio, role:paper} note{PIR Discrete case study.} agg Discrete.X1 1 claim dsev [0 8 10] [1/2 1/4 1/4] fixed agg Discrete.X2 1 claim dsev [0 1 90] [1/2 1/4 1/4] fixed hints{bs=1; log2=8; padding=1};
port PIRTame tags{topic:portfolio, role:paper} note{PIR Tame case study. For reinsurance see text.} agg Tame.A 1 claim sev gamma 50 cv 0.10 fixed agg Tame.B 1 claim sev gamma 50 cv 0.15 fixed hints{bs=1/64; log2=16; padding=1};

# ----------------------------------------------------------------------
# Severity curve reference
# ----------------------------------------------------------------------
sev Berens1997.Lognorm lognorm 150000 cv 0.25 note{Berens1997} tags{topic:severity, role:reference, role:paper};
sev Berens1997.Pareto 50000 * pareto 1.5 note{Berens1997} tags{topic:severity, role:reference, role:paper};
sev Bodoff2017.Pareto 50000 * lomax 1.5 note{Bodoff2017} tags{topic:severity, role:reference, role:paper};
agg CurveBeta 1 claim sev 100000 * beta 2 5 fixed note{Beta on [0, 100000] -- bounded severity / destruction rate, shapes a=2, b=5.} tags{topic:severity, role:reference};
agg CurveBetaPrime 1 claim sev 10000 * betaprime 3 4 fixed note{Beta-prime / beta-of-the-2nd-kind (B2) -- the GB2 representative. Cummins et al. (1990).} tags{topic:severity, role:reference};
agg CurveBurr12 1 claim sev 10000 * burr12 3 1.2 fixed note{Burr XII / Singh-Maddala (GB2, p=1), shapes c=3, d=1.2.} tags{topic:severity, role:reference};
agg CurveBurrIII 1 claim sev 10000 * burr 3 1.2 fixed note{Burr III / Dagum (GB2, q=1), shapes c=3, d=1.2.} tags{topic:severity, role:reference};
agg CurveExponential 1 claim sev 10000 * expon fixed note{Exponential: constant hazard, cv = 1. scipy expon; scale = mean.} tags{topic:severity, role:reference};
agg CurveFrechet 1 claim sev 10000 * invweibull 3 fixed note{Frechet / inverse Weibull (type II extreme value), shape c = 3.} tags{topic:severity, role:reference};
agg CurveGEV 1 claim sev 10000 * genextreme -0.2 + 20000 fixed note{Generalized extreme value (GEV), shape -0.2 (Frechet domain).} tags{topic:severity, role:reference};
agg CurveGPD 1 claim sev 10000 * genpareto 0.3 fixed note{Generalized Pareto (GPD), xi = 0.3 -- the peaks-over-threshold tail (EVT).} tags{topic:severity, role:reference};
agg CurveGamma 1 claim sev gamma 10000 cv 0.8 fixed note{Gamma severity by mean and cv (shape = 1/cv^2). Klugman et al.; Parodi.} tags{topic:severity, role:reference};
agg CurveGenGamma 1 claim sev 10000 * gengamma 2 1.5 fixed note{Generalized (transformed) gamma, shapes a=2, c=1.5 -- nests gamma/Weibull/lognormal.} tags{topic:severity, role:reference};
agg CurveGumbel 1 claim sev 5000 * gumbel_r + 20000 fixed note{Gumbel (type I extreme value) -- block maxima, light tail.} tags{topic:severity, role:reference};
agg CurveInverseGamma 1 claim sev 10000 * invgamma 4.07 fixed note{Inverse gamma, shape a = 4.07 -- heavy right tail (Klugman et al.).} tags{topic:severity, role:reference};
agg CurveInverseGaussian 1 claim sev invgauss 10000 cv 0.7 fixed note{Inverse Gaussian by mean and cv -- right-skewed, Tweedie-adjacent.} tags{topic:severity, role:reference};
agg CurveLogLogistic 1 claim sev 10000 * fisk 2.5 fixed note{Log-logistic / Fisk (GB2, p=q=1), shape c=2.5.} tags{topic:severity, role:reference};
agg CurveLognormal 1 claim sev lognorm 10000 cv 1.5 fixed note{Lognormal by mean and cv -- the default working severity.} tags{topic:severity, role:reference};
agg CurveLomax 1 claim sev 10000 * lomax 2.5 fixed note{Lomax / Pareto Type II (shifted Pareto), alpha = 2.5.} tags{topic:severity, role:reference};
agg CurvePareto 1 claim sev 10000 * pareto 2.5 - 10000 fixed note{Pareto Type I (European), alpha = 2.5, shifted ground-up.} tags{topic:severity, role:reference};
agg CurveWeibull 1 claim sev 10000 * weibull_min 1.5 fixed note{Weibull (weibull_min), shape c = 1.5: increasing hazard.} tags{topic:severity, role:reference};
sev Jin2016.Gamma gamma 6 cv 0.5774 note{Jin2016} tags{topic:severity, role:reference, role:paper};
sev Jin2016.Pareto 100 * lomax 20 note{Jin2016} tags{topic:severity, role:reference, role:paper};
sev Kang2019.Pareto 3.5 * lomax 3.5 note{Kang2019} tags{topic:severity, role:reference, role:paper};
sev Mack2003.AmericanPareto 10000 * lomax 1.5 note{Mack2003} tags{topic:severity, role:reference, role:paper};
sev Mack2003.Lognorm lognorm 10000 cv 4.953 note{Mack2003} tags{topic:severity, role:reference, role:paper};
sev Mack2003.RiebesellPareto 10000 * lomax 0.737 note{Mack2003} tags{topic:severity, role:reference, role:paper};
sev Mata2005.Lognorm 11048 * lognorm 2.29 note{Mata2005} tags{topic:severity, role:reference, role:paper};


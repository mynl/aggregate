agg Bahnemann2015.Bahn.4.1
  dfreq [0 1 2] [0.6 0.3 0.1]
  dsev [1 2 3] [0.4 0.5 0.1]
  note{@Bahnemann2015, Example 4.1, a simple discrete aggregate.}


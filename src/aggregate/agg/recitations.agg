# Enterprise Risk Analysis, Section 2.5  [Brehm2007.qmd]
# ----------------------------------------------------------------------

port Brehm2007.ABCD
  note{@Brehm2007, Section 2.5, the gross portfolio of the reinsurance example.}
  agg Casualty
    14 premium at 0.78 lr
    5 xs 0
    sev lognorm 0.1 cv 10
    mixed gamma 0.3
  agg PropertyNC
    17 premium at 0.63 lr
    25 xs 0
    sev lognorm [0.1 1] cv [5 10] wts [0.7 0.3]
    mixed gamma 0.1
  agg PropertyC
    2 premium at 0.63 lr
    150 xs 0
    sev 3 * pareto 2.375 + -3
    poisson

port Brehm2007.ABCD:Net
  note{@Brehm2007, Section 2.5, the same portfolio net of the reinsurance program.}
  agg Casualty
    14 premium at 0.78 lr
    5 xs 0
    sev lognorm 0.1 cv 10
    occurrence net of
      4 xs 1
    mixed gamma 0.3
  agg PropertyNC
    17 premium at 0.63 lr
    25 xs 0
    sev lognorm [0.1 1] cv [5 10] wts [0.7 0.3]
    occurrence net of
      17 xs 3
    mixed gamma 0.1
  agg PropertyC
    2 premium at 0.63 lr
    150 xs 0
    sev 3 * pareto 2.375 + -3
    occurrence net of
      24 xs 1
    poisson

port Brehm2007.ABCD:Ceded
  note{@Brehm2007, Section 2.5, the reinsurance program ceded from the portfolio.}
  agg Casualty
    14 premium at 0.78 lr
    5 xs 0
    sev lognorm 0.1 cv 10
    occurrence ceded to
      4 xs 1
    mixed gamma 0.3
  agg PropertyNC
    17 premium at 0.63 lr
    25 xs 0
    sev lognorm [0.1 1] cv [5 10] wts [0.7 0.3]
    occurrence ceded to
      17 xs 3
    mixed gamma 0.1
  agg PropertyC
    2 premium at 0.63 lr
    150 xs 0
    sev 3 * pareto 2.375 + -3
    occurrence ceded to
      24 xs 1
    poisson


# Examination Questions  [exam-questions.qmd]
# ----------------------------------------------------------------------

port Exam.CASq15
  note{@Bodoff2007, CAS Exam 9, Spring 2018, Question 15, wind and earthquake perils for percentile layer capital allocation.}
  agg X1
    1 claim
    dsev [0 5] [0.85 0.15]
    fixed
  agg X2
    1 claim
    dsev [0 15] [0.99 0.01]
    fixed

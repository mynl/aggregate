# Loss Data Analytics  [Frees2018a.qmd]
# ----------------------------------------------------------------------

agg Frees2018a.lda.3.3.5
  1 claim
  sev [200 200] * [expon pareto] [1 3] + [0 -200] wts [0.25 0.75]
  fixed
  note{@Frees2018a, Example 3.3.5, a mixture of an exponential and a Pareto.}

agg Frees2018a.lda.3.4.1
  1 claim
  inf xs 100
  sev 1000 * expon 1 !
  fixed
  note{@Frees2018a, Example 3.4.1, an exponential loss under a deductible of 100, per loss.}

agg Frees2018a.lda.3.4.2
  1 claim
  6 xs 4
  sev 10 * beta 2 1
  fixed
  note{@Frees2018a, Example 3.4.2, a beta loss under a deductible of 4.}

agg Frees2018a.X06
  1 claim
  500 xs 100
  sev 1000 * expon
  fixed
  note{@Frees2018a, Example 3.4.5, a health policy layer of 500 xs 100 in 2006.}

agg Frees2018a.X07
  1 claim
  500 xs 100
  sev 1050 * expon
  fixed
  note{@Frees2018a, Example 3.4.5, the same layer in 2007, after 5% trend.}

agg Frees2018a.insurer.net
  1 claim
  5000 xs 0
  sev 3600 * pareto 5 + -3600
  occurrence net of
    15% po 5000 xs 0
  fixed
  note{@Frees2018a, Example 3.4.6 modified, the insurer's share of a Pareto loss.}

agg Frees2018a.QU
  12 claims
  dsev [1 2 3] [0.5 0.3333333333333333 0.16666666666666666]
  poisson
  note{@Frees2018a, Example 5.3.1, the number of claimants from Poisson accidents.}

agg Frees2018a.lda.5.3.2
  dfreq [1 2] [0.8 0.2]
  dsev [0 100 1000] [0.2 0.7 0.1]
  note{@Frees2018a, Example 5.3.2, a discrete frequency and severity.}

agg Frees2018a.lda.5.3.3
  4 claims
  dsev [1 2 3 4]
  geometric
  note{@Frees2018a, Examples 5.3.3 and 5.4.1, a geometric discrete aggregate.}

agg Frees2018a.Pharma
  25 claims
  sev 90 * uniform + 5
  poisson
  note{@Frees2018a, Examples 5.3.5 and 5.4.2, a Poisson uniform aggregate.}

agg Frees2018a.Projects
  2 claims
  dsev [5 10 20] [0.2 0.3 0.5]
  geometric
  aggregate net of
    15 xs 0
  note{@Frees2018a, Example 5.3.6, the overtime hours paid in excess of 15 a week.}

agg Frees2018a.Projects.1
  2 claims
  dsev [5 10 20] [0.2 0.3 0.5]
  geometric
  aggregate ceded to
    inf xs 0
  note{@Frees2018a, Example 5.3.7, the expected overtime above 0 hours, one of four attachments.}

agg Frees2018a.Projects.1.v2
  2 claims
  dsev [5 10 20] [0.2 0.3 0.5]
  geometric
  aggregate ceded to
    inf xs 5
  note{@Frees2018a, Example 5.3.7, the expected overtime above 5 hours, one of four attachments.}

agg Frees2018a.LDA554
  3 claims
  sev 50 * burr12 1 3
  poisson zm 0.5
  note{@Frees2018a, Example 5.5.4, a zero modified Poisson Burr aggregate.}

agg Frees2018a.Original
  300 claims
  dsev [4 8 12 20]
  mixed gamma 0.07453559924999298
  note{@Frees2018a, Examples 5.5.5 and 5.5.6 modified, the group dental policy before the change.}

agg Frees2018a.Revised
  300 claims
  inf xs 10
  sev dhistogram xps [6 12 18 30] [0.25 0.25 0.25 0.25] !
  mixed gamma 0.07453559924999298
  note{@Frees2018a, Examples 5.5.5 and 5.5.6 modified, the group dental policy after the change.}

agg Frees2018a.Auto
  16 claims
  inf xs 100
  sev 200 * expon !
  poisson
  note{@Frees2018a, Example 5.5.7, the fleet after both modifications, severity per loss.}

agg Frees2018a.Auto.v2
  16 claims
  inf xs 100
  sev 200 * expon
  poisson
  note{@Frees2018a, Example 5.5.7, the same with severity per payment, which overstates the cost.}

agg Frees2018a.VaR
  1 claim
  dsev [1 3 4] [0.75 0.2 0.05]
  fixed
  note{@Frees2018a, Example 10.3.4, value at risk for a discrete variable.}

port Frees2018a.retained
  note{@Frees2018a, Example 10.4.3.3, the telecom risks retained under the deductibles.}
  agg building
    1 claim
    100 xs 0
    sev 100 * gamma 2
    fixed
  agg motor
    1 claim
    200 xs 0
    sev 200 * gamma 2
    fixed

port Frees2018a.insured
  note{@Frees2018a, Example 10.4.3.3, the telecom risks transferred to the insurer.}
  agg building
    1 claim
    inf xs 100
    sev 100 * gamma 2 !
    fixed
  agg motor
    1 claim
    inf xs 200
    sev 200 * gamma 2 !
    fixed
  agg d.and.o
    1 claim
    sev 1000 * pareto 2 + -1000
    fixed
  agg cyber
    1 claim
    sev 2000 * pareto 3 + -2000
    fixed

port Frees2018a.total
  note{@Frees2018a, Example 10.4.3.3, the telecom risks in total.}
  agg building
    1 claim
    sev 100 * gamma 2
    fixed
  agg motor
    1 claim
    sev 200 * gamma 2
    fixed
  agg d.and.o
    1 claim
    sev 1000 * pareto 2 + -1000
    fixed
  agg cyber
    1 claim
    sev 2000 * pareto 3 + -2000
    fixed



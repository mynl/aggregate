# k-moment tilting, and the exact answer it is approximating  [Liu2026.qmd]
# ----------------------------------------------------------------------

agg Liu2026.T
  dfreq [1]
  sev pareto 2.5
  note{@Liu2026, a Pareto claim used in the k-moment tilting comparison.}

agg Liu2026.T.v2
  dfreq [5]
  sev pareto 2.5
  note{@Liu2026, a Pareto claim used in the k-moment tilting comparison.}

agg Liu2026.T.v3
  dfreq [1]
  sev 1.1 * pareto 2.6
  note{@Liu2026, a Pareto claim used in the k-moment tilting comparison.}

agg Liu2026.T.v4
  dfreq [1]
  sev 1.2 * pareto 2.7
  note{@Liu2026, a Pareto claim used in the k-moment tilting comparison.}

port Liu2026.Paretos
  note{@Liu2026, Table 2's portfolio of non-identically distributed Paretos.}
  hints{log2=22;bs=1/8;padding=1;normalize=False}
  agg P0
    dfreq [1]
    sev pareto 2.5
  agg P1
    dfreq [1]
    sev 1.1 * pareto 2.6
  agg P2
    dfreq [1]
    sev 1.2 * pareto 2.7
  agg P3
    dfreq [1]
    sev 0.9 * pareto 2.8
  agg P4
    dfreq [1]
    sev 0.8 * pareto 2.9

port Liu2026.P
  note{@Liu2026, the same portfolio rebuilt across the grid sweep.}
  agg P0
    dfreq [1]
    sev pareto 2.5
  agg P1
    dfreq [1]
    sev 1.1 * pareto 2.6
  agg P2
    dfreq [1]
    sev 1.2 * pareto 2.7
  agg P3
    dfreq [1]
    sev 0.9 * pareto 2.8
  agg P4
    dfreq [1]
    sev 0.8 * pareto 2.9

port Liu2026.LT
  note{@Liu2026, Table C.1's light tailed portfolio, against an exact reference.}
  hints{log2=18;bs=1/1024;padding=1;normalize=False}
  agg C0
    dfreq [1]
    sev expon + 1
  agg C1
    dfreq [1]
    sev 0.8333333333333334 * expon + 1.1
  agg C2
    dfreq [1]
    sev 0.7142857142857143 * expon + 1.2
  agg C3
    dfreq [1]
    sev 0.6666666666666666 * expon + 0.9
  agg C4
    dfreq [1]
    sev 0.5555555555555556 * expon + 0.8



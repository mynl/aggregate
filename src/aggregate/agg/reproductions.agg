  poisson
  note{@Grubel1999, a compound Poisson Levy severity, the aliasing case tilting repairs.}


# GEMAct's accuracy table measures the length of the grid  [Pittarello2024.qmd]
# ----------------------------------------------------------------------

agg Pittarello2024.PLM.XL
  4 claims
  20 xs 5
  sev gamma 5 !
  poisson
  note{@Pittarello2024, a GEMAct paper example: layers, reinstatements and Parodi lognormal contracts.}

agg Pittarello2024.PLM.Layer1
  0.5 claims
  100 xs 100
  sev 83.34 * genpareto 0.834 !
  poisson
  note{@Pittarello2024, a GEMAct paper example: layers, reinstatements and Parodi lognormal contracts.}

agg Pittarello2024.PLM.Layer3
  0.5 claims
  100 xs 100
  sev 83.34 * genpareto 0.834 !
  poisson
  aggregate ceded to
    200 xs 0
  note{@Pittarello2024, a GEMAct paper example: layers, reinstatements and Parodi lognormal contracts.}

xpnl Pittarello2024.PLM.Layer2
  1 premium
  less
    agg PLM.Layer2Gross
      0.5 claims
      sev 83.34 * genpareto 0.834
      occurrence net of
        200 xs 100 deposit 1 reinstatements [0.6 0.6] as Layer
      poisson
  note{@Pittarello2024, a GEMAct paper example: layers, reinstatements and Parodi lognormal contracts.}

agg Pittarello2024.PLM.RS
  0.5 claims
  100 xs 0
  sev 100 * pareto 1.2 + -100 !
  poisson
  note{@Pittarello2024, a GEMAct paper example: layers, reinstatements and Parodi lognormal contracts.}

agg Pittarello2024.PLM.Layer2Net
  0.5 claims
  200 xs 100
  sev 83.34 * genpareto 0.834 !
  poisson
  note{@Pittarello2024, a GEMAct paper example: layers, reinstatements and Parodi lognormal contracts.}


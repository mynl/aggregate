  note{@Bear1990, Treaty IV, retrospective rating.}

pnl Bear1990.BN.TreatyIV.v3
  retro basic 0 lcm 1.3333333333 min 360 max 1200 premium
  less
    agg BN.Four
      [9000 3000] premium at [0.04 0.03] lr
      160 xs 0
      sev 40 * pareto [0.9 0.95] + -40
      mixed gamma 0.31622776601683794
  note{@Bear1990, Treaty IV, retrospective rating.}

xpnl Bear1990.BN.TreatyV.v2
  18000 premium
  less
    agg BN.Five
      [6000 6000 6000] premium at [0.1 0.14 0.21] lr
      700 xs 0
      sev 300 * pareto [1.5 1.3 1.1] + -300
      mixed gamma 0.22360679774997896
      aggregate net of
        80% po 100000 xs 0 deposit 5625 pc 0.25 after 0.2 as "PC layer"
  note{@Bear1990, Treaty V, a three year profit commission.}

xpnl Bear1990.BN.TreatyV.v3
  18000 premium
  less
    agg BN.Five
      [6000 6000 6000] premium at [0.1 0.14 0.21] lr
      700 xs 0
      sev 300 * pareto [1.5 1.3 1.1] + -300
      mixed gamma 0.31622776601683794
      aggregate net of
        80% po 100000 xs 0 deposit 5625 pc 0.25 after 0.2 as "PC layer"
  note{@Bear1990, Treaty V, a three year profit commission.}

xpnl Bear1990.BN.TreatyVI.v3
  25000 premium
  less
    agg BN.Six
      25000 premium at 0.1 lr
      900 xs 0
      sev 100 * pareto 0.98 + -100
      mixed gamma 0.22360679774997896
      aggregate net of
        100000 xs 0 deposit 5000 slide 0.4 at 0.35 and 0.25 at 0.55 and 0.2 at 0.65 as Slide
  note{@Bear1990, Treaty VI, a sliding scale commission.}

xpnl Bear1990.BN.TreatyVI.v4
  25000 premium
  less
    agg BN.Six
      25000 premium at 0.1 lr
      900 xs 0
      sev 100 * pareto 0.98 + -100
      mixed gamma 0.31622776601683794
      aggregate net of
        100000 xs 0 deposit 5000 slide 0.4 at 0.35 and 0.25 at 0.55 and 0.2 at 0.65 as Slide
  note{@Bear1990, Treaty VI, a sliding scale commission.}

xpnl Bear1990.BN.TreatyIIp
  1172 premium
  less
    agg BN.Two
      [2000 2000 2000] premium at [0.1 0.14 0.21] lr
      700 xs 0
      sev 300 * pareto [1.5 1.3 1.1] + -300
      occurrence net of
        700 xs 0 deposit 1172 reinstatements [1 1 1] as Layer
      poisson
  note{@Bear1990, Treaty II with paid rather than free reinstatements.}


# Risk load by layer, and a misprinted basic limit  [Wang2000.qmd]
# ----------------------------------------------------------------------

agg Wang2000.Wang.Layers
  1 claim
  10000000 xs 0
  sev 2000 * lomax 1.2
  occurrence ceded to
    50000 xs 0 and
    50000 xs 50000 and
    100000 xs 100000 and
    100000 xs 200000 and
    100000 xs 300000 and
    100000 xs 400000 and
    500000 xs 500000 and
    1000000 xs 1000000 and
    3000000 xs 2000000 and
    5000000 xs 5000000
  fixed
  note{@Wang2000, Table 1's ground up loss ceded to the paper's layer tower.}

distortion Wang2000.wang_a wang 0.1
  note{@Wang2000, the Wang transform at the paper lambda.}

distortion Wang2000.ph_r ph 0.9245
  note{@Wang2000, the proportional hazard transform at the paper r.}

distortion Wang2000.tmp ph 0.9
  note{@Wang2000, a proportional hazard transform from the sweep over r.}

distortion Wang2000.tmp.v2 ph 0.95
  note{@Wang2000, a proportional hazard transform from the sweep over r.}


# Pricing weather options from 22 observations  [Wang2002.qmd]
# ----------------------------------------------------------------------

agg Wang2002.HDD
  1 claim
  dsev [972.5 1147 1244 901 1573 1055 1488 1065.5 1018.5 1155 1474.5 1129.5 1077.5 1129.5 1090.5 938.5 1199.5 1156 1040 940.5 1090.5 1517.5]
  fixed
  note{@Wang2002, the 22 observed heating degree day totals as a discrete severity.}

distortion Wang2002.wang25 wang 0.25
  note{@Wang2002, the Wang transform used to price the option.}


# A horizontal line that settles a misprint  [Denuit2019.qmd]
# ----------------------------------------------------------------------

port Denuit2019.D61a
  note{@Denuit2019, Section 6.1's two participant pool under conditional mean risk sharing.}
  agg P1
    0.08 claims
    dsev [1 2 3 4] [0.1 0.2 0.4 0.3]
    poisson
  agg P2
    0.08 claims
    dsev [1 2 3 4] [0.15 0.25 0.3 0.3]
    poisson
  agg P3
    0.1 claims
    dsev [1 2 3 4] [0.1 0.2 0.4 0.3]
    poisson
  agg P4
    0.1 claims
    dsev [1 2 3 4] [0.15 0.25 0.3 0.3]
    poisson

port Denuit2019.D61b
  note{@Denuit2019, Section 6.1's two participant pool under conditional mean risk sharing.}
  agg P1
    0.08 claims
    dsev [1 2 3 4] [0.1 0.2 0.4 0.3]
    poisson
  agg P2
    0.08 claims
    dsev [1 2 3 4] [0.15 0.25 0.3 0.3]
    poisson
  agg P3
    0.1 claims
    dsev [1 2 3 4] [0.1 0.2 0.3 0.4]
    poisson
  agg P4
    0.1 claims
    dsev [1 2 3 4] [0.15 0.25 0.3 0.3]
    poisson

port Denuit2019.Denuit61
  note{@Denuit2019, Section 6.1's two participant pool under conditional mean risk sharing.}
  agg P1
    0.08 claims
    dsev [1 2 3 4] [0.1 0.2 0.4 0.3]
    poisson
  agg P2
    0.08 claims
    dsev [1 2 3 4] [0.15 0.25 0.3 0.3]
    poisson
  agg P3
    0.1 claims
    dsev [1 2 3 4] [0.1 0.2 0.4 0.3]
    poisson
  agg P4
    0.1 claims
    dsev [1 2 3 4] [0.15 0.25 0.3 0.3]
    poisson


# Mortality credits, and what happens as the fund grows  [Denuit2022b.qmd]
# ----------------------------------------------------------------------

port Denuit2022b.Fund100
  note{@Denuit2022b, Example 4.5's two group mortality pool at n = 100.}
  agg Low
    6 claims
    dsev [1]
    binomial 0.1
  agg High
    8 claims
    dsev [3]
    binomial 0.2

port Denuit2022b.Fund500
  note{@Denuit2022b, Example 4.5's two group mortality pool at n = 500.}
  agg Low
    30 claims
    dsev [1]
    binomial 0.1
  agg High
    40 claims
    dsev [3]
    binomial 0.2


# A non-monotone allocation, and the algorithm that repairs it  [Denuit2025a.qmd]
# ----------------------------------------------------------------------

port Denuit2025a.Denuit.Pool.v2
  note{@Denuit2025a, Section 3.2's three agent pool of truncated severities.}
  hints{log2=16; bs=0.002; normalize=False; padding=1}
  agg Agent1
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg Agent2
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg Agent3
    1 claim
    sev 2 * gamma [1 8] wts [0.504541349633 0.495458650367] splice [0 0] [30 30]
    fixed

port Denuit2025a.Denuit.PoolAlt
  note{@Denuit2025a, Section 3.2's three agent pool of truncated severities.}
  hints{log2=16; bs=0.002; normalize=False; padding=1}
  agg A1
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg A2
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg A3
    1 claim
    sev 2 * gamma [1 8] wts=2
    fixed

port Denuit2025a.Denuit.PoolB
  note{@Denuit2025a, Section 3.2's three agent pool of truncated severities.}
  hints{log2=16; bs=0.002; normalize=False; padding=1}
  agg B1
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg B2
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg B3
    1 claim
    sev 2 * gamma [1 8] wts=2 splice [0 0] [30 30]
    fixed


# Where a conditional expectation given the sum turns over  [Denuit2025.qmd]
# ----------------------------------------------------------------------

port Denuit2025.K
  note{@Denuit2025, a two agent pool where the conditional mean allocation turns over.}
  hints{log2=20; bs=0.01; normalize=False; padding=1}
  agg X
    1 claim
    sev pareto 3.5
    fixed
  agg Y
    1 claim
    sev pareto 2.5
    fixed

port Denuit2025.K.v2
  note{@Denuit2025, a two agent pool where the conditional mean allocation turns over.}
  hints{log2=20; bs=0.01; normalize=False; padding=1}
  agg X
    1 claim
    sev pareto 2.5
    fixed
  agg Y
    1 claim
    sev pareto 1.5
    fixed

port Denuit2025.K.v3
  note{@Denuit2025, a two agent pool where the conditional mean allocation turns over.}
  hints{log2=18; bs=0.002; normalize=False; padding=1}
  agg X
    1 claim
    sev lomax 3.5
    fixed
  agg Y
    1 claim
    sev lomax 3
    fixed


# Twenty eight stop loss premiums, and the grid they need  [Gerber1982.qmd]
# ----------------------------------------------------------------------

agg Gerber1982.Gerber
  1 claim
  sev 2 * uniform + 1
  poisson
  hints{log2=18; bs=0.0009765625}
  note{@Gerber1982, a compound Poisson on a uniform severity, for the stop loss table.}

agg Gerber1982.Gerber.v2
  10 claims
  sev 2 * uniform + 1
  poisson
  hints{log2=18; bs=0.0078125}
  note{@Gerber1982, a compound Poisson on a uniform severity, for the stop loss table.}

agg Gerber1982.Gerber.v3
  100 claims
  sev 2 * uniform + 1
  poisson
  note{@Gerber1982, a compound Poisson on a uniform severity, for the stop loss table.}


# An exact table a lattice method cannot match  [Robertson1992.qmd]

# Five papers, five programs  [summary.qmd]
# ----------------------------------------------------------------------

agg Venter1983.Venter
  13.7376 claims
  250000 xs 0
  sev chistogram xps [0 1000 5000 6000 7000 8000 9000 10000 12500 15000 17500 20000 25000 35000 50000 75000 100000 125000 150000 175000 200000 225000 250000 300000] [0.38935 0.38935 0.00568 0.00543 0.00517 0.00495 0.00473 0.01098 0.00989 0.00896 0.00815 0.01426 0.02237 0.02353 0.02459 0.01517 0.01021 0.00732 0.00547 0.00423 0.00337 0.00274 0.0241]
  poisson
  note{@Venter1983, Exhibit 3, a compound Poisson over a tabulated claim size law.}

agg Bear1990.BN.One
  [9000 3000] premium at [0.04 0.03] lr
  160 xs 0
  sev 40 * pareto [0.9 0.95] + -40
  poisson
  note{@Bear1990, the subject book of two excess casualty classes.}

agg Bear1990.BN.One.v2
  [9000 3000] premium at [0.04 0.03] lr
  160 xs 0
  sev 40 * pareto [0.9 0.95] + -40
  poisson
  aggregate net of
    360 xs 0
  note{@Bear1990, Treaty I, an annual aggregate deductible on the subject book.}

agg Homer2003.HC
  5 claims
  dsev [200000 400000 600000 800000 1000000] [0.378 0.235 0.146 0.091 0.15]
  occurrence net of
    400000 xs 600000
  mixed gamma 0.2
  note{@Homer2003, Section 2's per occurrence layer, whose net and ceded views give Table 2.3.}

agg Bruno2006.B7
  91000 claims
  dsev [14 15 16 17 18 19 20 24 26 28 30 31 55 60] [0.0103301 0.030799 0.0293511 0.0103301 0.0730414 0.0111568 0.0264554 0.1002133 0.0815418 0.0252146 0.0212857 0.0254214 0.0991756 0.4556837]
  poisson
  note{@Bruno2006, Table 7's compound Poisson at lambda = 91,000.}

port Denuit2025a.Denuit.Pool
  note{@Denuit2025a, Section 3.2's three agent pool of truncated severities.}
  agg Agent1
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg Agent2
    1 claim
    sev 2 * expon splice [0 10]
    fixed
  agg Agent3
    1 claim
    sev 2 * gamma [1 8] wts [0.504541349633 0.495458650367] splice [0 0] [30 30]
    fixed


# The threshold above which Riebesell is consistent  [Mack2003.qmd]
# ----------------------------------------------------------------------

agg Mack2003.S
  1 claim
  0.01 xs 0
  sev expon
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v2
  1 claim
  0.1 xs 0
  sev expon
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v3
  1 claim
  sev expon
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, unlimited.}

agg Mack2003.S.v4
  1 claim
  0.01 xs 0
  sev 10 * gamma 0.1
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v5
  1 claim
  0.1 xs 0
  sev 10 * gamma 0.1
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v6
  1 claim
  sev 10 * gamma 0.1
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, unlimited.}

agg Mack2003.S.v7
  1 claim
  0.01 xs 0
  sev lognorm 1 cv 4.95315270785704
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v8
  1 claim
  0.1 xs 0
  sev lognorm 1 cv 4.95315270785704
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v9
  1 claim
  sev lognorm 1 cv 4.95315270785704
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, unlimited.}

agg Mack2003.S.v10
  1 claim
  0.01 xs 0
  sev 0.5 * lomax 1.5
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v11
  1 claim
  0.1 xs 0
  sev 0.5 * lomax 1.5
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, limited at one layer top.}

agg Mack2003.S.v12
  1 claim
  sev 0.5 * lomax 1.5
  fixed
  note{@Mack2003, a severity behind the Table 1 exposure curve, unlimited.}

agg Mack2003.Riebesell
  1 claim
  5000000 xs 0
  sev [9894.934954 259286.6924] * [lognorm pareto] [1.8 0.7369655942] wts [0.965191548087 0.034808451913] splice [0 259286.6924 inf]
  fixed
  note{@Mack2003, the spliced severity whose Pareto tail makes Riebesell's rule consistent.}

agg Mack2003.Riebesell.v2
  1 claim
  50000 xs 0
  sev [9894.934954 259286.6924] * [lognorm pareto] [1.8 0.7369655942] wts [0.965191548087 0.034808451913] splice [0 259286.6924 inf]
  fixed
  note{@Mack2003, the spliced severity whose Pareto tail makes Riebesell's rule consistent.}



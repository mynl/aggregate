agg Mata2005.M
  1 claim
  250000 xs 0
  sev lognorm 152062.97146657703 cv 13.727535749987513
  fixed
  note{@Mata2005, the lognormal severity behind Table 1, limited at one layer top.}

agg Mata2005.M.v2
  1 claim
  500000 xs 0
  sev lognorm 152062.97146657703 cv 13.727535749987513
  fixed
  note{@Mata2005, the lognormal severity behind Table 1, limited at one layer top.}

agg Mata2005.M.v3
  1 claim
  sev lognorm 152062.97146657703 cv 13.727535749987513
  fixed
  note{@Mata2005, the lognormal severity behind Table 1, unlimited.}

agg Mata2005.M.v4
  1 claim
  sev lognorm 103491.50327117534 cv 13.727535749987513
  fixed
  note{@Mata2005, the lognormal severity behind Table 1, unlimited.}


# A policy limit that only usually holds  [Bodoff2017.qmd]
# ----------------------------------------------------------------------

agg Bodoff2017.B
  1 claim
  50000 xs 0
  sev 50000 * lomax 1.5
  fixed
  note{@Bodoff2017, Exhibit 4's Pareto severity under a policy limit.}

agg Bodoff2017.B.v2
  1 claim
  100000 xs 0
  sev 50000 * lomax 1.5
  fixed
  note{@Bodoff2017, Exhibit 4's Pareto severity under a policy limit.}


# The bivariate FFT, twenty years early  [Homer2003.qmd]
# ----------------------------------------------------------------------

bivariate Homer2003.A
  dfreq [2]
  dbvsev [0 1 2] [0 1 2] [[0.4 0 0] [0.3 0.3 0] [0 0 0]]
  note{@Homer2003, the toy bivariate severity that checks the two dimensional convolution.}

bivariate Homer2003.HC3
  4 claims
  dbvsev [0 200000 400000 600000 800000 1000000] [0 200000 400000 600000 800000 1000000 1200000] [[0.08389999999999327 0.014699999999998822 0.0012999999999998956 9.9999999999992e-05 0 0 0] [0.27979999999997757 0.13289999999998933 0.03159999999999747 0.004999999999999599 0.0005999999999999518 9.9999999999992e-05 0] [0.04149999999999668 0.03209999999999742 0.012499999999998998 0.003199999999999744 0.0005999999999999518 9.9999999999992e-05 0] [0.030699999999997542 0.03299999999999736 0.01769999999999858 0.006399999999999488 0.0016999999999998637 0.000399999999999968 9.9999999999992e-05] [0.022799999999998172 0.03129999999999749 0.021499999999998274 0.009899999999999208 0.0033999999999997275 0.0008999999999999279 0.000199999999999984] [0.033756260434097296 0.05659432387309546 0.047378964941596206 0.02644407345579788 0.011118530884799109 0.003706176961599703 0.0010016694490799197]]
  mixed gamma 0.5
  note{@Homer2003, Section 3's loss subject to an aggregate, plus unlimited ALAE.}

bivariate Homer2003.HC4
  10 claims
  dbvsev [0 200000 400000 600000 800000] [0 1 2 3 4 5] [[0 0.10000000000000002 0 0 0 0] [0.43800000000000006 0 0 0 0 0] [0.24600000000000002 0 0 0 0 0] [0.13800000000000004 0 0 0 0 0] [0.07800000000000001 0 0 0 0 0]]
  mixed gamma 0.31622776601683794
  note{@Homer2003, Section 4's joint distribution of dollars against counts.}

bivariate Homer2003.HC4b
  10 claims
  dbvsev [0 200000 400000 600000 800000] [0 1 2 3 4 5] [[0 0.10000000000000002 0 0 0 0] [0.43800000000000006 0 0 0 0 0] [0.24600000000000002 0 0 0 0 0] [0.13800000000000004 0 0 0 0 0] [0.07800000000000001 0 0 0 0 0]]
  mixed gamma 0.31622776601683794
  note{@Homer2003, Section 4's joint distribution on the smaller grid, for the reach comparison.}


# Six adjustable features, one clause each  [Bear1990.qmd]
# ----------------------------------------------------------------------

port Bear1990.BearNemlick.One
  note{@Bear1990, the Table I subject book as a two class portfolio.}
  agg Class1
    9000 premium at 0.04 lr
    160 xs 0
    sev 40 * pareto 0.9 + -40
    mixed gamma 0.07879574790219362
  agg Class2
    3000 premium at 0.03 lr
    160 xs 0
    sev 40 * pareto 0.95 + -40
    mixed gamma 0.22335691114062584

port Bear1990.BearNemlick.Two
  note{@Bear1990, the Treaty II subject book as a three class portfolio.}
  agg Class1
    2000 premium at 0.1 lr
    700 xs 0
    sev 300 * pareto 1.5 + -300
    mixed gamma 0.09022811434760547
  agg Class2
    2000 premium at 0.14 lr
    700 xs 0
    sev 300 * pareto 1.3 + -300
    mixed gamma 0.09869275424396479
  agg Class3
    2000 premium at 0.21 lr
    700 xs 0
    sev 300 * pareto 1.1 + -300
    mixed gamma 0.12408498159738195

xpnl Bear1990.BN.TreatyII
  1172 premium
  less
    agg BN.Two
      [2000 2000 2000] premium at [0.1 0.14 0.21] lr
      700 xs 0
      sev 300 * pareto [1.5 1.3 1.1] + -300
      occurrence net of
        700 xs 0 deposit 1172 reinstatements [0 0 0] as Layer
      poisson
  note{@Bear1990, Treaty II, three free reinstatements.}

agg Bear1990.BN.TwoAlt
  [2000 2000 2000] premium at [0.1 0.14 0.21] lr
  700 xs 0
  sev 300 * pareto [1.5 1.3 1.1] + -300
  poisson
  aggregate ceded to
    2800 xs 0
  note{@Bear1990, Treaty II's layer ceded as an aggregate rather than walked.}

xpnl Bear1990.BN.TreatyIII
  10000 premium
  less
    agg BN.Three
      [4500 4500 1000] premium at [0.032 0.038 0.035] lr
      400 xs 0
      sev 100 * pareto 1.1 + -100
      poisson
      aggregate net of
        10000 xs 0 deposit 350 corridor 1 po 1 xs 1 as Corridor
  note{@Bear1990, Treaty III, a loss corridor.}

xpnl Bear1990.BN.TreatyIIIb
  10000 premium
  less
    agg BN.Three
      [4500 4500 1000] premium at [0.032 0.038 0.035] lr
      400 xs 0
      sev 100 * pareto 1.1 + -100
      poisson
      aggregate net of
        10000 xs 0 deposit 366.9658642415209 corridor 1 po 0.9537671868292504 xs 0.9537671868292504 as Corridor
  note{@Bear1990, Treaty III at a recalibrated deposit and corridor.}

pnl Bear1990.BN.TreatyIV
  retro basic 0 lcm 1.3333333333 min 360 max 1200 premium
  less
    agg BN.Four
      [9000 3000] premium at [0.04 0.03] lr
      160 xs 0
      sev 40 * pareto [0.9 0.95] + -40
      poisson
  note{@Bear1990, Treaty IV, retrospective rating.}

xpnl Bear1990.BN.TreatyV
  18000 premium
  less
    agg BN.Five
      [6000 6000 6000] premium at [0.1 0.14 0.21] lr
      700 xs 0
      sev 300 * pareto [1.5 1.3 1.1] + -300
      poisson
      aggregate net of
        80% po 100000 xs 0 deposit 5625 pc 0.25 after 0.2 as "PC layer"
  note{@Bear1990, Treaty V, a three year profit commission.}

xpnl Bear1990.BN.TreatyVI
  25000 premium
  less
    agg BN.Six
      25000 premium at 0.1 lr
      900 xs 0
      sev 100 * pareto 0.98 + -100
      poisson
      aggregate net of
        100000 xs 0 deposit 5000 slide 0.4 at 0.35 and 0.25 at 0.55 and 0.2 at 0.65 as Slide
  note{@Bear1990, Treaty VI, a sliding scale commission.}

xpnl Bear1990.BN.TreatyVI.v2
  25000 premium
  less
    agg BN.Six
      25000 premium at 0.1 lr
      900 xs 0
      sev 100 * pareto 0.95 + -100
      poisson
      aggregate net of
        100000 xs 0 deposit 5000 slide 0.4 at 0.35 and 0.25 at 0.55 and 0.2 at 0.65 as Slide
  note{@Bear1990, Treaty VI, a sliding scale commission.}


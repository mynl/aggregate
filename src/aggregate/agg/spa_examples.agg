# ======================================================================
# spa_examples.agg -- curated DecL example library for the aggregate_api SPA
# ======================================================================
#
# Parsed by aggregate_api (GET /v1/examples) to populate the playground's
# "Examples" dropdown. Format:
#
#   * Contents block -- one "# <Letter>. <Title>" line per category (A-O).
#     These set the dropdown's category titles.
#   * Item lines -- a runnable DecL program whose object name follows the
#     "<Letter>.<Name>" convention, e.g. "agg A.Basic ...". The letter
#     prefix files the example under its category; the dot is part of the
#     object name.
#   * A trailing "note{...}" on an item becomes its description.
#   * "#" comment lines and blank lines are ignored (except Contents lines).
#
# Programs must start with a top-level keyword: agg, sev, port, dist, pnl,
# mv / multivariate, or "netceded agg".
#
# Contents
# --------
# A. Aggregates -- getting started
# B. Portfolios
# C. Reinsurance
# D. Multivariate and dependent risks
# E. Profit and loss
# F. Severity and frequency features

# ----------------------------------------------------------------------
# A. Aggregates -- getting started
# ----------------------------------------------------------------------
agg A.ThreeDice dfreq [3] dsev [1:6] note{Sum of the rolls of three dice.};
agg A.DiceDice dfreq [1:6] dsev [1:6] note{Roll a die for the claim count, then sum that many die rolls.};
agg A.Basic 15 claims 10000 xs 0 sev lognorm 1500 cv 1.0 poisson note{A plain Poisson / lognormal aggregate.}

# ----------------------------------------------------------------------
# B. Portfolios
# ----------------------------------------------------------------------
port B.BasicPort agg A 50 claims 1000 xs 0 sev lognorm 100 cv 1.2 mixed gamma 0.4 agg B 65 claims 2000 xs 0 sev lognorm 150 cv 1.6 mixed gamma 0.2 note{Two-unit portfolio.};
port B.PnLPort pnl Cat 2000 prem - 55% lr sev lognorm 500 cv 3 poisson pnl Prop 5000 prem - 65% lr sev lognorm 100 cv 2 poisson note{Portfolio of two profit-and-loss units.}

# ----------------------------------------------------------------------
# C. Reinsurance
# ----------------------------------------------------------------------
agg C.BasicXOL 15 claims 10000 xs 0 sev lognorm 1500 cv 1.0 occurrence net of 50% po 2500 xs 2500 and 90% po 5000 xs 5000 mixed gamma 0.25 note{Occurrence excess-of-loss program, net view.};
agg C.Reins 1250 premium at 80% lr 1000 xs 0 sev lognorm 80 cv 1.675 occurrence ceded to 125 xs 0 and 50% po 125 xs 125 and 20% po 250 xs 250 and 5% po 500 xs 500 poisson note{Layered occurrence reinsurance, ceded view.}

# ----------------------------------------------------------------------
# D. Multivariate and dependent risks
# ----------------------------------------------------------------------
mv D.Cat 25 claims agg Wind dfreq [0 1] [.3 .7] sev lognorm 40 cv 0.65 splice [0 250] agg Flood dfreq [0 1] [.5 .5] sev lognorm 60 cv 0.95 splice [0 300] mixed gamma .2 note{Common-shock multivariate (mv): Wind and Flood share frequency mixing.};
netceded agg D.NetCeded 15 claims 10000 xs 0 sev lognorm 1500 cv 1.0 occurrence net of 50% po 2500 xs 2500 and 90% po 5000 xs 5000 mixed gamma 0.25 note{Gross / ceded / net joint view of a reinsured book.};
multivariate D.MVGumbel 25 claims agg Wind dfreq [0 1] [.3 .7] sev lognorm 40 cv 1.2 agg Flood dfreq [0 1] [.5 .5] sev lognorm 60 cv 1.5 copula gumbel 0.4 poisson note{Gumbel-copula dependence between Wind and Flood.}

# ----------------------------------------------------------------------
# E. Profit and loss
# ----------------------------------------------------------------------
pnl E.PNL 1000 prem - 90% lr 1000 xs 0 sev lognorm 120 cv 1 mixed gamma .25 note{Single profit-and-loss line.};
pnl E.PnLMix [100 200 100] prem - .8 lr [1000 2000 5000] xs 0 sev lognorm 500 cv 2 poisson note{Vector premium: shift 400, mean 80 = sum premium_i (1 - lr).}

# ----------------------------------------------------------------------
# F. Severity and frequency features
# ----------------------------------------------------------------------
agg F.MixedMixed [5 10 8 2] claims [1 5 10 20] xs 0 sev lognorm 10 cv 1.2 mixed gamma 0.2 note{Limit profile, single severity.};
agg F.Tweedie tweedie 1 1.005 0.1 note{Tweedie via mean, p, dispersion; variance = dispersion * mean**p.};
agg F.Signed dfreq [3] dsev [-2 5] [.5 .5] note{Signed severity -- negative outcomes allowed.};
agg F.Windowed 10_000 claims dsev [-1 1] poisson note{Windowed / discrete severity at high frequency.};
agg F.ApproxGamma 5000 claim sev lognorm 100 cv 2 poisson approximate sgamma note{Shifted-gamma moment approximation.};
agg F.ExactGamma 5000 claim sev lognorm 100 cv 2 poisson note{Exact computation}
